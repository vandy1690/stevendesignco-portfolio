{
	"name": "portfolio-astro",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"check:docs": "node scripts/check-docs-in-step.mjs",
		"check:claims": "node scripts/check-claims.mjs",
		"check:names": "node scripts/check-names.mjs",
		"adoption": "node scripts/adoption.mjs",
		"build:manifest": "node scripts/build-manifest.mjs",
		"manifest:check": "node scripts/build-manifest.mjs --check",
		"qa": "node qa/run.mjs",
		"ship": "npm run check:hooks && npm run tokens:check && npm run check:types && npm run manifest:check && npm run check:names && npm run check:docs && npm run build:docs && npm run check:docs-built && npm run build && npm run qa && npm run check:claims",
		"build:docs": "cd docs-site && npm run build",
		"tokens": "node scripts/build-tokens.mjs",
		"tokens:check": "node scripts/build-tokens.mjs --check",
		"check:types": "astro check",
		"prepare": "node scripts/setup-hooks.mjs",
		"setup:hooks": "node scripts/setup-hooks.mjs",
		"check:hooks": "node scripts/setup-hooks.mjs --check",
		"check:docs-built": "node scripts/check-docs-built.mjs"
	},
	"dependencies": {
		"@astrojs/react": "^5.0.4",
		"@astrojs/vercel": "^10.0.6",
		"@fontsource/inter": "^5.2.8",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"astro": "^6.2.1",
		"lenis": "^1.3.4",
		"react": "^19.2.5",
		"react-dom": "^19.2.5"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@types/node": "^22.20.5",
		"axe-core": "^4.13.0",
		"playwright": "^1.63.0",
		"pngjs": "^7.0.0",
		"typescript": "^5.9.3"
	}
}
