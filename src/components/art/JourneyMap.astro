---
// Card art for the checkout dead end. The structure of the board, not the
// board: earlier touchpoints across roughly a month, marked by whether they
// send the customer a message today, and the moment at checkout where the
// order stops. The dashed return arc is the argument the board made, that the
// dead end could have been resolved earlier. No screens, no internal names.
---

<div class="jm" aria-hidden="true">
	<svg class="jm__svg" viewBox="0 0 640 300" xmlns="http://www.w3.org/2000/svg">
		<text class="jm__axis" x="40" y="60">about a month before</text>
		<text class="jm__axis jm__axis--end" x="600" y="60">checkout</text>

		<line class="jm__track" x1="40" y1="150" x2="560" y2="150" />

		<path class="jm__return" d="M 570 132 C 500 40, 200 40, 132 132" />
		<polyline class="jm__return" points="122,118 132,134 148,128" />
		<text class="jm__hint" x="330" y="96">could have been resolved here</text>

		<g class="jm__node jm__node--message"><circle cx="132" cy="150" r="9" /></g>
		<g class="jm__node jm__node--silent"><circle cx="228" cy="150" r="9" /></g>
		<g class="jm__node jm__node--silent"><circle cx="324" cy="150" r="9" /></g>
		<g class="jm__node jm__node--message"><circle cx="420" cy="150" r="9" /></g>
		<g class="jm__node jm__node--silent"><circle cx="500" cy="150" r="9" /></g>

		<g class="jm__stop">
			<rect x="556" y="126" width="30" height="48" rx="6" />
			<line x1="565" y1="136" x2="577" y2="164" />
			<line x1="577" y1="136" x2="565" y2="164" />
		</g>
		<text class="jm__stoplabel" x="571" y="196">order stops</text>

		<g class="jm__legend">
			<circle class="jm__lg jm__lg--message" cx="48" cy="248" r="6" />
			<text x="62" y="252">sends a message today</text>
			<circle class="jm__lg jm__lg--silent" cx="248" cy="248" r="6" />
			<text x="262" y="252">sends nothing</text>
		</g>
	</svg>
</div>

<style>
	.jm { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; padding: clamp(12px, 3%, 28px); color: var(--text); }
	.jm__svg { width: 100%; height: auto; max-width: 640px; display: block; }
	.jm__axis { fill: var(--text-mute); font-family: var(--font-body); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 600; }
	.jm__axis--end { text-anchor: end; }
	.jm__track { stroke: currentColor; stroke-width: 1.5; opacity: 0.45; }
	.jm__return { fill: none; stroke: var(--accent); stroke-width: 1.8; stroke-dasharray: 5 6; stroke-linecap: round; stroke-linejoin: round; }
	.jm__hint { fill: var(--accent); font-family: var(--font-body); font-size: 13px; font-weight: 600; text-anchor: middle; }
	.jm__node--message circle { fill: var(--accent); stroke: none; }
	.jm__node--silent circle { fill: var(--bg); stroke: currentColor; stroke-width: 1.6; opacity: 0.75; }
	.jm__stop rect { fill: var(--text); }
	.jm__stop line { stroke: var(--bg); stroke-width: 2.2; stroke-linecap: round; }
	.jm__stoplabel { fill: currentColor; font-family: var(--font-display); font-size: 15px; font-weight: 400; font-variation-settings: "wght" 400, "slnt" 0, "ital" 0; letter-spacing: 0.03em; text-anchor: middle; }
	.jm__legend text { fill: var(--text-mute); font-family: var(--font-body); font-size: 13px; }
	.jm__lg--message { fill: var(--accent); }
	.jm__lg--silent { fill: var(--bg); stroke: currentColor; stroke-width: 1.4; opacity: 0.75; }
</style>
