---
// Card art for Merchant Flow Builder. A compact version of the pipeline diagram
// on the case study page: the brief form captures a guide section link, the link
// travels through structured JSON, and the plugin assembles the flow page with
// every placeholder still pointing at its source. Inline SVG, currentColor and
// the accent token, so it themes with the page. The plugin UI itself is PayPal
// internal and is not reproduced.
---

<div class="pp" aria-hidden="true">
	<svg class="pp__svg" viewBox="0 0 640 360" xmlns="http://www.w3.org/2000/svg">
		<g class="pp__panel">
			<rect x="24" y="72" width="168" height="200" rx="12" />
			<line x1="48" y1="112" x2="140" y2="112" />
			<line x1="48" y1="140" x2="164" y2="140" />
			<line x1="48" y1="168" x2="116" y2="168" />
		</g>
		<rect class="pp__accent" x="48" y="206" width="120" height="26" rx="7" />
		<text class="pp__label" x="60" y="224">guide link</text>
		<text class="pp__title" x="24" y="52">Brief form</text>

		<g class="pp__panel">
			<rect x="236" y="72" width="168" height="200" rx="12" />
			<text class="pp__mono" x="260" y="120">{"{"}</text>
			<text class="pp__mono" x="276" y="146">merchant,</text>
			<text class="pp__mono" x="276" y="172">flows: [</text>
			<text class="pp__mono" x="260" y="256">{"]}"}</text>
		</g>
		<rect class="pp__accent" x="276" y="196" width="112" height="26" rx="7" />
		<text class="pp__label" x="288" y="214">guide link</text>
		<text class="pp__title" x="236" y="52">Structured JSON</text>

		<g class="pp__panel">
			<rect x="448" y="72" width="168" height="200" rx="12" />
			<rect x="470" y="98" width="36" height="64" rx="6" />
			<rect x="514" y="98" width="36" height="64" rx="6" />
			<rect x="558" y="98" width="36" height="64" rx="6" />
			<line x1="470" y1="184" x2="594" y2="184" />
		</g>
		<rect class="pp__accent" x="470" y="206" width="124" height="26" rx="7" />
		<text class="pp__label" x="482" y="224">guide link</text>
		<text class="pp__title" x="448" y="52">Flow page</text>

		<g class="pp__arrow">
			<line x1="200" y1="172" x2="226" y2="172" />
			<polyline points="218,165 228,172 218,179" />
			<line x1="412" y1="172" x2="438" y2="172" />
			<polyline points="430,165 440,172 430,179" />
		</g>

		<text class="pp__foot" x="24" y="322">Most of a day</text>
		<line class="pp__footrule" x1="150" y1="317" x2="196" y2="317" />
		<polyline class="pp__footrule" points="190,312 198,317 190,322" />
		<text class="pp__foot pp__foot--strong" x="208" y="322">10 to 15 minutes, across the 38-merchant program</text>
	</svg>
</div>

<style>
	.pp { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; padding: clamp(12px, 3%, 28px); color: var(--text); }
	.pp__svg { width: 100%; height: auto; max-width: 640px; display: block; }
	.pp__panel rect, .pp__panel line { fill: none; stroke: currentColor; stroke-width: 1.4; opacity: 0.5; }
	.pp__panel line { stroke-width: 7; stroke-linecap: round; opacity: 0.16; }
	.pp__accent { fill: var(--accent); }
	.pp__label { fill: var(--accent-text); font-family: var(--font-body); font-size: 13px; font-weight: 600; letter-spacing: 0.02em; }
	.pp__title { fill: currentColor; font-family: var(--font-display); font-size: 17px; font-weight: 400; font-variation-settings: "wght" 400, "slnt" 0, "ital" 0; letter-spacing: 0.03em; }
	.pp__mono { fill: currentColor; opacity: 0.55; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 15px; }
	.pp__arrow line, .pp__arrow polyline { fill: none; stroke: currentColor; stroke-width: 1.6; opacity: 0.55; stroke-linecap: round; stroke-linejoin: round; }
	.pp__foot { fill: var(--text-mute); font-family: var(--font-body); font-size: 14px; }
	.pp__foot--strong { fill: currentColor; font-weight: 600; }
	.pp__footrule { fill: none; stroke: var(--accent); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
</style>
