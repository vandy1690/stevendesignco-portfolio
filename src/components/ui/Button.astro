---
/**
 * Button
 * A link styled as a button. Everything on this site that looks like a button
 * is a navigation, so this renders an <a> and there is no <button> variant.
 *
 * Pass `variant="primary"` for the one action a page wants. Secondary is the
 * default and is everything else. Never two primaries in one view.
 *
 * Pass `external` for anything that leaves the site or opens a new tab. It adds
 * target, rel and the hidden "(opens in a new tab)" warning together, so the
 * three can never drift apart.
 */
interface Props {
	href: string;
	/** Which of the two styles the Figma library defines. Secondary by default. */
	variant?: 'primary' | 'secondary';
	/** Opens in a new tab and says so to a screen reader. */
	external?: boolean;
	class?: string;
}
const { href, variant = 'secondary', external = false, class: cls } = Astro.props;
const classes = ['sdc-btn', variant === 'primary' && 'sdc-btn--primary', cls];
---

{external ? (
	<a class:list={classes} href={href} target="_blank" rel="noopener"><slot /><span class="sdc-u-sr-only"> (opens in a new tab)</span></a>
) : (
	<a class:list={classes} href={href}><slot /></a>
)}
