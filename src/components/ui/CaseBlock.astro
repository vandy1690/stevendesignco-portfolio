---
/**
 * CaseBlock
 * The prose unit a case study is written in: a label, a one line claim, then
 * the paragraphs that back it up.
 *
 * @element sdc-case-block
 *
 * The claim is the heading, so it carries the page outline and should read as
 * a sentence a reader could skim on its own. Put the detail in the slot.
 */
import Eyebrow from './Eyebrow.astro';

interface Props {
	/** The small label above the claim. */
	eyebrow: string;
	/** The one line claim. Becomes the heading. */
	lede?: string;
}
const { eyebrow, lede } = Astro.props;
---

<sdc-case-block>
	<Eyebrow>{eyebrow}</Eyebrow>
	{lede && <h2 class="sdc-case-block__lede">{lede}</h2>}
	<slot />
</sdc-case-block>
