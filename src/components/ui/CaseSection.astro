---
/**
 * CaseSection
 * One band of a case study. Bands alternate between the page background and
 * the slightly darker surface, which is what `alt` controls. Alternate every
 * other band; two in a row reads as one long band.
 *
 * The inner element is what holds the measure. `inner` names the layout inside
 * it: "cs-body" for prose, "cs-back" for the pager row, "" for a bare column.
 * Pass `inner={false}` when the band holds a full bleed figure and needs no
 * measure at all, and `flush` when that figure should sit tight against the
 * band above it instead of carrying its own top padding.
 */
interface Props {
	/** Darker surface. Alternate it, never two in a row. */
	alt?: boolean;
	/** Full bleed figure band. */
	figure?: boolean;
	/** No top padding, so the band sits flush against the one above. */
	flush?: boolean;
	/** Anchor target, for a link that jumps to this band. */
	id?: string;
	/** Layout class on the inner element, or false for no inner element. */
	inner?: string | false;
	/** Fades in on scroll. Off for bands that must be readable immediately. */
	animate?: boolean;
}
const { alt = false, figure = false, flush = false, id, inner = 'cs-body', animate = true } = Astro.props;
---

<section id={id} class:list={['section', alt && 'section--alt', figure && 'section--figure', flush && 'section--flush']}>
	{inner === false ? <slot /> : (
		<div class:list={['section__inner', inner]} data-animate={animate ? 'fade' : undefined}><slot /></div>
	)}
</section>
