---
/**
 * FormSummary
 * The error summary a form moves focus to when submission fails. One list of
 * what went wrong, each item a link to the control that needs fixing.
 *
 * role="alert" so it is announced when it appears, and tabindex -1 so script
 * can focus it without making it a tab stop. Hidden until there is something
 * to say: an empty alert region that is always present announces nothing and
 * confuses everything.
 *
 * Three tones, one per status colour. Each follows the palette's own contract:
 * the tint is the ground, the ink sits on it, the solid draws the border. Error
 * is the default, because a failed submit is the common case.
 *
 * Added 2026-10-23 with the rest of the control set.
 *
 * @docs components/form-messages
 */
interface Props {
	/** Ties a form's script to this region. */
	id?: string;
	/** The sentence above the list. */
	lede?: string;
	/** One per item. `id` is the control to jump to. */
	errors?: { id: string; message: string }[];
	/** Which status colour to wear. Error is a failed submit, warning is saved with something to check, success is done. */
	tone?: 'error' | 'warning' | 'success';
	class?: string;
}
const { id = 'form-summary', lede = 'That did not send yet.', errors = [], tone = 'error', class: cls } = Astro.props;
---

<div
	class:list={[
		'sdc-form-summary',
		tone === 'warning' && 'sdc-form-summary--warning',
		tone === 'success' && 'sdc-form-summary--success',
		cls,
	]}
	id={id}
	role="alert"
	tabindex="-1"
	hidden={(tone === 'error' && errors.length === 0) || undefined}
>
	<strong>{lede}</strong>
	{errors.length > 0 && (
		<ul>
			{errors.map((e) => (
				<li><a href={`#${e.id}`}>{e.message}</a></li>
			))}
		</ul>
	)}
</div>
