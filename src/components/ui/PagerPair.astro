---
/**
 * PagerPair
 * The band that closes every case study: back or previous on the left, the
 * next case study on the right. It owns its own section so a page cannot
 * forget the surrounding markup or put it in the wrong band.
 *
 * The two sit side by side at every width, including phones.
 */
import Pager from './Pager.astro';

interface Link {
	href: string;
	label: string;
	/** Read before the visible text by a screen reader. */
	prefix?: string;
}
interface Props {
	prev: Link;
	next: Link;
}
const { prev, next } = Astro.props;
---

<sdc-section tone="alt">
	<sdc-layout-container layout="pager">
		<Pager direction="prev" href={prev.href} label={prev.label} prefix={prev.prefix} />
		<Pager direction="next" href={next.href} label={next.label} prefix={next.prefix} />
	</sdc-layout-container>
</sdc-section>
