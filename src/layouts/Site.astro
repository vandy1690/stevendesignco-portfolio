			.case .cs-orbit { display: grid; gap: var(--space-md); }
			.case .cs-orbit__art { margin-top: var(--space-md); }
			.case .cs-h2 { max-width: 22ch; margin: 0 0 var(--space-sm); }
			.case .cs-block .cs-caption { margin-top: var(--space-md); color: var(--text-mute); font-size: 14px; letter-spacing: 0.04em; }
			.case .cs-quote { margin: var(--space-lg) 0 0; padding: 0; border: 0; font-family: var(--font-display); font-weight: 400; font-style: normal; font-variation-settings: "wght" 400, "slnt" 0, "ital" 0; font-synthesis: none; font-size: var(--text-quote); line-height: 1.4; color: var(--text); max-width: 64ch; }
			.case .cs-block code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.92em; color: var(--text); }
			@media (max-width: 700px) {
				.case .cs-back { flex-wrap: nowrap; gap: 10px; align-items: stretch; }
				.case .cs-back .pager { flex: 1 1 0; min-width: 0; height: auto; min-height: 44px; padding: 9px 40px 9px 12px; font-size: 13px; line-height: 1.25; white-space: normal; }
				.case .cs-back .pager--prev { padding: 9px 12px 9px 40px; }
				.case .cs-back .pager__cap { width: 32px; }
				.case .cs-meta { grid-template-columns: 1fr; gap: var(--space-lg); }
				.case .cs-meta dt { font-size: 13px; letter-spacing: 0.1em; color: var(--text); margin-bottom: 2px; }
				.case .cs-meta dd { font-size: 17px; }
			}
			@media (max-width: 880px) {
				.case .cs-figure { max-width: 100%; }
				.case .cs-hero__title { font-size: var(--text-case-title); }
				/* The orbit is 680px wide and scaled to half below 880px, so it lands at
				   340px. Narrower than about 390px the page has less room than that and
				   the orbit used to push the whole document sideways, which is a reflow
				   failure. Clip rather than scroll. `clip` does not create a scroll port
				   the way `hidden` does; `hidden` is the fallback for older Safari. */
				.case .cs-orbit__art { width: 100%; aspect-ratio: 1 / 1; overflow: hidden; overflow: clip; margin-top: var(--space-md); }
			}

			/* An inline link inside prose is underlined. The accent and the body ink
			   measure 1.02:1 against each other, so colour alone leaves a link in a
			   sentence indistinguishable from the sentence. Links that are the whole
			   content of their row are not affected; there is no surrounding text to
			   confuse them with. */
			.case .cs-block p a:not(.btn):not(.pager) {
