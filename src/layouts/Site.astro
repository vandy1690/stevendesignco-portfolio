---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/900.css';
import '@fontsource/inter/900-italic.css';

// Adobe Fonts (Typekit) kit for Nickel Gothic Variable.
// Replace ADOBE_KIT_ID with the kit ID from fonts.adobe.com → Web Projects.
// Until set, --font-display falls back to Inter Black Italic.
const ADOBE_KIT_ID = 'eft2zbk';

interface Props {
	title: string;
	description?: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname;
const isHome = path === '/';
const SITE_URL = 'https://www.stevendesignco.com';
const ogImage = `${SITE_URL}/og-image.png`;
const canonical = `${SITE_URL}${path}`;
const GA_ID = 'G-RCWC0PX4G9';
const enableGA = import.meta.env.PROD;
---

<html lang="en" data-theme="light">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#F0EEE9" />
		{ADOBE_KIT_ID && <link rel="stylesheet" href={`https://use.typekit.net/${ADOBE_KIT_ID}.css`} />}
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Steven Design Co." />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		{description && <meta name="twitter:description" content={description} />}
		<meta name="twitter:image" content={ogImage} />
		{enableGA && (
			<>
				<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
				<script is:inline define:vars={{ GA_ID }}>
					window.dataLayer = window.dataLayer || [];
					function gtag(){dataLayer.push(arguments);}
					gtag('js', new Date());
					gtag('config', GA_ID);
				</script>
			</>
		)}
	</head>
	<body>
		<header class="site-header">
			<a class="brand" href="/" aria-label="Steven Vanden Heuvel home">
				<img class="brand__mark" src="/images/brand/SDC_initialLogo.svg" alt="Steven Vanden Heuvel" width="40" height="24" />
			</a>
			<nav class="nav">
				<a href={isHome ? '#work' : '/#work'}>Case Studies</a>
				<a href={isHome ? '#about' : '/#about'}>About</a>
				<a href={isHome ? '#contact' : '/#contact'}>Contact</a>
				<a class="nav__cta" href="/resume.pdf">Resume</a>
			</nav>
			<button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
				<span class="nav-toggle__bar"></span>
				<span class="nav-toggle__bar"></span>
				<span class="nav-toggle__bar"></span>
			</button>
		</header>

		<nav id="mobile-nav" class="nav-mobile" aria-hidden="true">
			<a href={isHome ? '#work' : '/#work'}>Case Studies</a>
			<a href={isHome ? '#about' : '/#about'}>About</a>
			<a href={isHome ? '#contact' : '/#contact'}>Contact</a>
			<a href="/resume.pdf">Resume</a>
		</nav>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="site-footer__inner">
				<a class="brand brand--footer" href="/">
					<img src="/images/brand/SDC_initialLogo.svg" alt="" width="36" height="22" />
					<span>Steven Design Services LLC</span>
				</a>
				<div class="site-footer__meta">
					<span>© Steven Vanden Heuvel</span>
					<a class="js-email" data-eml="73746576656e4073746576656e64657369676e636f2e636f6d" href="#" aria-label="Email Steven">steven [at] stevendesignco [dot] com</a>
				</div>
			</div>
		</footer>

		<script>
			// Fade-in on scroll
			const els = document.querySelectorAll<HTMLElement>('[data-animate="fade"]');
			if (els.length && 'IntersectionObserver' in window) {
				const io = new IntersectionObserver((entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							io.unobserve(entry.target);
						}
					});
				}, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
				els.forEach((el) => io.observe(el));
			} else {
				els.forEach((el) => el.classList.add('is-visible'));
			}

			// Mobile nav toggle
			const navToggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
			const navMobile = document.querySelector<HTMLElement>('#mobile-nav');
			if (navToggle && navMobile) {
				const setOpen = (open: boolean) => {
					navMobile.dataset.open = String(open);
					navToggle.setAttribute('aria-expanded', String(open));
					navMobile.setAttribute('aria-hidden', String(!open));
					navToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
					document.body.classList.toggle('nav-open', open);
				};
				navToggle.addEventListener('click', () => {
					setOpen(navMobile.dataset.open !== 'true');
				});
				navMobile.querySelectorAll('a').forEach((a) => {
					a.addEventListener('click', () => setOpen(false));
				});
				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape' && navMobile.dataset.open === 'true') setOpen(false);
				});
			}

			// Email reveal: hex-decode data-eml at runtime so plain-text scrapers miss it
			document.querySelectorAll<HTMLAnchorElement>('a.js-email').forEach((a) => {
				const hex = a.dataset.eml;
				if (!hex) return;
				let email = '';
				for (let i = 0; i < hex.length; i += 2) {
					email += String.fromCharCode(parseInt(hex.substr(i, 2), 16));
				}
				a.href = 'mailto:' + email;
				a.textContent = email;
			});
		</script>

		<style is:global>
			:root {
				color-scheme: light dark;

				/* color tokens — dark theme (default) */
				--bg: #000000;            /* color/background */
				--surface: #111111;       /* color/surface */
				--surface-2: #1a1a1a;     /* derived */
				--text: #ffffff;          /* color/text/heading + body + secondary + action */
				--text-mute: #666666;     /* matches Figma's caption color (#666) */
				--rule: rgba(255, 255, 255, 0.20);   /* color/divider */
				--rule-soft: rgba(255, 255, 255, 0.10);
				--lime: #CCFF00;          /* color/primary + accent */
				--lime-text: #000000;     /* color/accent-text */
				--lime-hover: #d8ff33;    /* derived hover state */
				--lime-glow: rgba(204, 255, 0, 0.20);
				--header-bg: rgba(0, 0, 0, 0.78);

				/* layout tokens (from Layout Tokens) */
				--max: 1280px;            /* layout/content-width */
				--max-narrow: 800px;      /* layout/content-narrow */
				--gutter: 24px;           /* layout/content-padding */
				--nav-h: 56px;            /* layout/nav-height */
				--radius: 18px;
				--radius-sm: 10px;

				/* spacing tokens (from Spacing Tokens) */
				--space-xs: 8px;
				--space-sm: 16px;
				--space-md: 24px;
				--space-lg: 32px;
				--space-xl: 48px;
				--space-2xl: 64px;
				--space-3xl: 96px;
				--space-4xl: 128px;
				--space-5xl: 160px;

				/* type-scale tokens (from Typography Tokens) */
				--font-display: 'nickel-gothic-variable', 'Inter', system-ui, sans-serif;
				--font-body: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
				--text-display-1: clamp(48px, 8vw, 96px);   /* hero headlines */
				--text-display-2: clamp(32px, 4.8vw, 48px); /* section titles */
				--text-heading: clamp(24px, 3.2vw, 32px);   /* case study titles */
				--text-deck: clamp(18px, 1.9vw, 24px);      /* taglines, intros */
				--text-subheading: 20px;                    /* section labels */
				--text-body: 16px;                          /* paragraph */
				--text-nav: 15px;                           /* navigation */
				--text-body-sm: 14px;                       /* captions */
				--text-label: 11px;                         /* tags, metadata */
			}

			/* Light theme: applied when system requests light AND user has not
			   explicitly chosen dark, OR when user has explicitly chosen light. */
			/* Light theme: Atmospheric palette (Pantone candidate, June 2026).
			   Warm Cloud Dancer paper, charcoal body text, Regatta blue as the
			   single accent. Dusky Citron #E2C56E is the optional warm pop. */
			@media (prefers-color-scheme: light) {
				:root:not([data-theme="dark"]) {
					color-scheme: light;
					--bg: #F0EEE9;                       /* Cloud Dancer */
					--surface: #E4E1DA;                  /* warm card, derived */
					--surface-2: #D8D4CB;                /* hover */
					--text: #2D3436;                     /* charcoal body */
					--text-mute: #6E7574;                /* muted charcoal */
					--rule: rgba(45, 52, 54, 0.20);
					--rule-soft: rgba(45, 52, 54, 0.10);
					--lime: #4A6FA8;                     /* Regatta, accent */
					--lime-text: #ffffff;
					--lime-hover: #3D5C8C;
					--lime-glow: rgba(74, 111, 168, 0.22);
					--header-bg: rgba(240, 238, 233, 0.82);
				}
			}
			:root[data-theme="light"] {
				color-scheme: light;
				--bg: #F0EEE9;                       /* Cloud Dancer */
				--surface: #E4E1DA;                  /* warm card, derived */
				--surface-2: #D8D4CB;                /* hover */
				--text: #2D3436;                     /* charcoal body */
				--text-mute: #6E7574;                /* muted charcoal */
				--rule: rgba(45, 52, 54, 0.20);
				--rule-soft: rgba(45, 52, 54, 0.10);
				--lime: #4A6FA8;                     /* Regatta, accent */
				--lime-text: #ffffff;
				--lime-hover: #3D5C8C;
				--lime-glow: rgba(74, 111, 168, 0.22);
				--header-bg: rgba(240, 238, 233, 0.82);
			}
			* { box-sizing: border-box; }
			html, body { margin: 0; padding: 0; }
			html { background: var(--bg); }
			body {
				background: var(--bg);
				color: var(--text);
				font-family: var(--font-body);
				font-size: var(--text-body);
				line-height: 1.6;
				overflow-x: clip;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
			}
			::selection { background: var(--lime); color: var(--lime-text); }
			a { color: var(--lime); text-decoration: none; }
			a:hover { text-decoration: none; }

			h1, h2, h3 { color: var(--text); margin: 0; line-height: 1.1; letter-spacing: -0.022em; font-weight: 700; }
			h1 { font-size: var(--text-display-1); line-height: 0.98; letter-spacing: -0.03em; }
			h2 { font-size: var(--text-display-2); line-height: 1.04; letter-spacing: -0.025em; }
			h3 {
				font-family: var(--font-display);
				font-size: 18px;
				font-weight: 900;
				font-style: normal;
				font-variation-settings: "wght" 900, "slnt" 0, "ital" 0;
				font-synthesis: none;
				line-height: 1.1;
				letter-spacing: 0.01em;
				color: var(--lime);
			}
			p { margin: 0 0 1em; }
			img, svg { display: block; max-width: 100%; }

			/* Display style: Nickel Gothic Variable, normal weight, upright */
			.display {
				font-family: var(--font-display);
				font-weight: 400;
				font-style: normal;
				font-variation-settings: "wght" 400, "slnt" 0, "ital" 0;
				font-synthesis: none;
				letter-spacing: normal;
				line-height: 0.96;
			}

			.eyebrow {
				font-size: var(--text-label);
				letter-spacing: 0.16em;
				text-transform: uppercase;
				color: var(--lime);
				margin: 0 0 var(--space-md);
				font-weight: 600;
			}
			.eyebrow--mute { color: var(--text-mute); }

			/* Header */
			.site-header {
				position: sticky;
				top: 0;
				z-index: 30;
				display: flex;
				align-items: center;
				justify-content: space-between;
				height: var(--nav-h);
				padding: 0 var(--gutter);
				background: var(--header-bg);
				-webkit-backdrop-filter: saturate(180%) blur(14px);
				backdrop-filter: saturate(180%) blur(14px);
				border-bottom: 1px solid var(--rule-soft);
			}
			.brand {
				display: inline-flex;
				align-items: center;
				gap: 14px;
				color: var(--text);
				letter-spacing: -0.01em;
				font-weight: 600;
				font-size: var(--text-body);
			}
			.brand:hover { color: var(--text); }
			.brand__mark { display: block; height: 24px; width: auto; }
			/* SDC mark SVG has hardcoded lime fills — invert to black in light mode */
			@media (prefers-color-scheme: light) {
				:root:not([data-theme="dark"]) .brand img { filter: brightness(0); }
			}
			:root[data-theme="light"] .brand img { filter: brightness(0); }
			.nav { display: flex; align-items: center; gap: var(--space-lg); }
			.nav a {
				color: var(--text);
				font-size: var(--text-nav);
				font-weight: 500;
				transition: color 0.12s ease, opacity 0.12s ease;
				opacity: 0.8;
			}
			.nav a:hover { color: var(--text); opacity: 1; }
			.nav__cta {
				padding: 8px 16px;
				border-radius: 999px;
				border: 1px solid var(--rule);
				color: var(--text) !important;
				opacity: 1 !important;
				transition: background 0.14s ease, border-color 0.14s ease, color 0.14s ease;
			}
			.nav__cta:hover { background: var(--lime); color: var(--lime-text) !important; border-color: var(--lime); }

			/* Theme toggle (sun/moon) — floating in bottom-right corner */
			.theme-toggle {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				background: var(--bg);
				border: 1px solid var(--rule);
				border-radius: 999px;
				color: var(--text);
				cursor: pointer;
				padding: 0;
				transition: border-color 0.14s ease, color 0.14s ease, background 0.14s ease, transform 0.12s ease;
			}
			.theme-toggle:hover { border-color: var(--text); color: var(--text); transform: translateY(-1px); }
			.theme-toggle__sun, .theme-toggle__moon { display: block; }
			.theme-toggle__label { display: none; }

			.theme-toggle--float {
				position: fixed;
				right: 20px;
				bottom: 20px;
				z-index: 40;
				width: 48px;
				height: 48px;
				box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
				-webkit-backdrop-filter: blur(8px);
				backdrop-filter: blur(8px);
			}
			@media (max-width: 600px) {
				.theme-toggle--float { right: 16px; bottom: 16px; width: 44px; height: 44px; }
			}
			/* Dark theme: show sun icon (click → switch to light) */
			.theme-toggle__moon { display: none; }
			/* Light theme: show moon icon (click → switch to dark) */
			@media (prefers-color-scheme: light) {
				:root:not([data-theme="dark"]) .theme-toggle__sun { display: none; }
				:root:not([data-theme="dark"]) .theme-toggle__moon { display: block; }
			}
			:root[data-theme="light"] .theme-toggle__sun { display: none; }
			:root[data-theme="light"] .theme-toggle__moon { display: block; }
			:root[data-theme="dark"] .theme-toggle__sun { display: block; }
			:root[data-theme="dark"] .theme-toggle__moon { display: none; }

			/* Hamburger toggle (mobile) */
			.nav-toggle {
				display: none;
				width: 40px;
				height: 40px;
				margin-right: -8px;
				background: none;
				border: none;
				padding: 8px;
				cursor: pointer;
				flex-direction: column;
				justify-content: space-between;
				align-items: stretch;
			}
			.nav-toggle__bar {
				display: block;
				height: 2px;
				background: var(--text);
				border-radius: 2px;
				transition: transform 0.18s ease, opacity 0.18s ease;
				transform-origin: center;
			}
			.nav-toggle[aria-expanded="true"] .nav-toggle__bar:nth-child(1) {
				transform: translateY(11px) rotate(45deg);
			}
			.nav-toggle[aria-expanded="true"] .nav-toggle__bar:nth-child(2) { opacity: 0; }
			.nav-toggle[aria-expanded="true"] .nav-toggle__bar:nth-child(3) {
				transform: translateY(-11px) rotate(-45deg);
			}

			/* Mobile nav overlay */
			.nav-mobile {
				display: none;
				position: fixed;
				top: var(--nav-h);
				left: 0;
				right: 0;
				bottom: 0;
				background: var(--bg);
				flex-direction: column;
				padding: var(--space-md) var(--gutter) var(--space-2xl);
				z-index: 25;
				border-top: 1px solid var(--rule-soft);
				overflow-y: auto;
			}
			.nav-mobile[data-open="true"] { display: flex; }
			.nav-mobile a {
				display: block;
				padding: var(--space-md) 0;
				font-family: var(--font-display);
				font-weight: 400;
				font-style: normal;
				font-variation-settings: "wght" 400, "slnt" 0, "ital" 0;
				font-synthesis: none;
				font-size: clamp(28px, 6vw, 40px);
				color: var(--text);
				border-bottom: 1px solid var(--rule);
				letter-spacing: normal;
				line-height: 1.1;
			}
			.nav-mobile a:hover,
			.nav-mobile a:focus-visible { color: var(--lime); }
			body.nav-open { overflow: hidden; }

			/* Sections (shared) */
			.section { padding: var(--space-2xl) var(--gutter); }
			.section--alt { background: var(--bg); }

			/* Theme-aware image swap: pair a .theme-img--dark with .theme-img--light,
			   the browser will paint whichever matches the active theme.
			   !important is used so these win over scoped page styles that target img. */
			.theme-img--light { display: none !important; }
			@media (prefers-color-scheme: light) {
				:root:not([data-theme="dark"]) .theme-img--dark { display: none !important; }
				:root:not([data-theme="dark"]) .theme-img--light { display: block !important; }
			}
			:root[data-theme="light"] .theme-img--dark { display: none !important; }
			:root[data-theme="light"] .theme-img--light { display: block !important; }
			:root[data-theme="dark"] .theme-img--dark { display: block !important; }
			:root[data-theme="dark"] .theme-img--light { display: none !important; }

			/* Fade-in on scroll, observed via tiny script at end of body */
			[data-animate="fade"] {
				opacity: 0;
				transform: translateY(12px);
				transition: opacity 0.8s ease-out, transform 0.8s ease-out;
			}
			[data-animate="fade"].is-visible {
				opacity: 1;
				transform: translateY(0);
			}
			@media (prefers-reduced-motion: reduce) {
				[data-animate="fade"] { opacity: 1; transform: none; transition: none; }
			}
			.section--ink { background: var(--bg); }
			.section__inner { max-width: var(--max); margin: 0 auto; }
			.section__inner--narrow { max-width: var(--max-narrow); }
			.prose { max-width: var(--max-narrow); font-size: 18px; color: var(--text); line-height: 1.7; font-weight: 400; }
			.prose p { margin: 0 0 1.2em; }
			.prose strong { color: var(--text); font-weight: 600; }

			/* Buttons */
			.btn {
				display: inline-flex;
				align-items: center;
				gap: var(--space-xs);
				padding: 14px 22px;
				border-radius: 999px;
				border: 1px solid var(--rule);
				background: transparent;
				color: var(--text);
				font-family: var(--font-body);
				font-size: var(--text-nav);
				font-weight: 600;
				letter-spacing: -0.005em;
				transition: background 0.14s ease, border-color 0.14s ease, color 0.14s ease, transform 0.12s ease;
				cursor: pointer;
			}
			.btn:hover { border-color: var(--text); transform: translateY(-1px); }
			.btn--primary { background: var(--lime); color: var(--lime-text); border-color: var(--lime); }
			.btn--primary:hover {
				background: var(--lime-hover);
				border-color: var(--lime-hover);
				color: var(--lime-text);
				box-shadow: 0 14px 40px -10px var(--lime-glow);
			}

			/* Footer */
			.site-footer {
				padding: var(--space-xl) var(--gutter);
				border-top: 1px solid var(--rule-soft);
				background: var(--bg);
			}
			.site-footer__inner {
				max-width: var(--max);
				margin: 0 auto;
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: var(--space-md);
				flex-wrap: wrap;
			}
			.brand--footer { font-size: var(--text-body-sm); color: var(--text-mute); font-weight: 500; }
			.brand--footer:hover { color: var(--text); }
			.site-footer__meta { display: flex; gap: var(--space-md); color: var(--text-mute); font-size: var(--text-body-sm); }
			.site-footer__meta a { color: var(--text-mute); }
			.site-footer__meta a:hover { color: var(--lime); }

			@media (max-width: 880px) {
				.nav { display: none; }
				.nav-toggle { display: flex; }
				.section { padding: var(--space-xl) var(--gutter); }
			}
		</style>
	</body>
</html>
