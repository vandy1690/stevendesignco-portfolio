			/* min-height carries these to the 24px minimum target size. Both sat at 22. */
			.brand--footer { font-size: var(--text-body-sm); color: var(--text-mute); font-weight: 500; min-height: 24px; }
			.brand--footer:hover { color: var(--text); }
			.site-footer__meta { display: flex; gap: var(--space-md); color: var(--text-mute); font-size: var(--text-body-sm); }
