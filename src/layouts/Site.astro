			.case .dg-panel rect, .case .dg-panel line { fill: none; stroke: currentColor; stroke-width: 1.25; opacity: 0.45; }
			.case .dg-panel line { stroke-width: 6; stroke-linecap: round; opacity: 0.22; }
			.case .dg-accent-fill { fill: var(--accent); }
			.case .dg-accent-label { fill: var(--accent-text); font-family: var(--font-body); font-size: 13px; font-weight: 600; letter-spacing: 0.02em; }
			.case .dg-title { fill: currentColor; font-family: var(--font-display); font-size: 17px; font-weight: 400; font-variation-settings: "wght" 400, "slnt" 0, "ital" 0; font-synthesis: none; letter-spacing: 0.03em; }
			.case .dg-note { fill: var(--text-mute); font-family: var(--font-body); font-size: 13.5px; }
