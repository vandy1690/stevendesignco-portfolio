---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import '@fontsource/inter/900.css';
import '@fontsource/inter/900-italic.css';

// Adobe Fonts (Typekit) kit for Nickel Gothic Variable.
// Replace ADOBE_KIT_ID with the kit ID from fonts.adobe.com → Web Projects.
// Until set, --font-display falls back to Inter Black Italic.
const ADOBE_KIT_ID = 'uic8bwd';

interface Props {
	title: string;
	description?: string;
	/** Path to a page-specific social card under /public, e.g. "/og/plate.png".
	    Falls back to the site-wide /og-image.png when omitted. */
	image?: string;
	/** "case" turns on the case study page styles. See the .case block below. */
	variant?: 'case';
}

const { title, description, image, variant } = Astro.props;
const path = Astro.url.pathname;
const isHome = path === '/';
const SITE_URL = 'https://www.stevendesignco.com';
const ogImage = `${SITE_URL}${image ?? '/og-image.png'}`;
const canonical = `${SITE_URL}${path}`;
const GA_ID = 'G-RCWC0PX4G9';
const enableGA = import.meta.env.PROD;

const ogType = isHome ? 'website' : 'article';
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			'@id': `${SITE_URL}/#person`,
			name: 'Steven Vanden Heuvel',
			url: SITE_URL,
			image: `${SITE_URL}/images/about/headshot.jpg`,
			jobTitle: 'Product Designer',
			address: { '@type': 'PostalAddress', addressLocality: 'Aurora', addressRegion: 'IL', addressCountry: 'US' },
			sameAs: ['https://www.linkedin.com/in/stevendesignco'],
			knowsAbout: ['Product Design', 'Design Systems', 'Interaction Design', 'Checkout and Payments', 'Design Tooling', 'Figma Plugins', 'Responsive Web Products'],
			description: 'I make products feel considered, and I build the systems that keep them that way, usually before anyone asks.',
			alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Wisconsin-Whitewater' },
			award: [
				'2017 Jesse H. Neal Award, Best Website (Plate)',
				'4 Jesse H. Neal Awards',
				'Grand Jesse H. Neal Award Finalist, top 4 nationally',
				'Folio OZZIE Honorable Mention',
				'Multiple ASBPE Awards',
			],
		},
		{
			'@type': 'WebSite',
			'@id': `${SITE_URL}/#website`,
			name: 'Steven Design Co.',
			url: SITE_URL,
			author: { '@id': `${SITE_URL}/#person` },
		},
		...(path.startsWith('/work/')
			? [
					{
						'@type': 'Article',
						'@id': `${canonical}#article`,
						headline: title.split(' · ')[0],
						description,
						image: ogImage,
						url: canonical,
						mainEntityOfPage: canonical,
						author: { '@id': `${SITE_URL}/#person` },
					},
					{
						'@type': 'BreadcrumbList',
						'@id': `${canonical}#breadcrumbs`,
						itemListElement: [
							{ '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
							{ '@type': 'ListItem', position: 2, name: 'Case Studies', item: `${SITE_URL}/#work` },
							{ '@type': 'ListItem', position: 3, name: title.split(' · ')[0], item: canonical },
						],
					},
				]
			: []),
		...(path === '/resume'
			? [
					{
						'@type': 'ProfilePage',
						'@id': `${canonical}#profilepage`,
						url: canonical,
						mainEntity: { '@id': `${SITE_URL}/#person` },
					},
				]
			: []),
	],
};
---

<html lang="en" data-theme="light">
	<head>
		<meta charset="utf-8" />
		<!-- Resolve the theme before anything paints. The attribute on <html> is
		     "light" so a blocked script still renders a finished page; this script
		     replaces it with the stored choice, or the operating system preference
		     when there is no choice yet. It is inline and synchronous on purpose:
		     deferring it means a visible flash of the wrong palette. -->
		<script is:inline>
			(function () {
				try {
					var stored = localStorage.getItem('theme');
					var theme =
						stored === 'light' || stored === 'dark'
							? stored
							: window.matchMedia('(prefers-color-scheme: dark)').matches
								? 'dark'
								: 'light';
					document.documentElement.setAttribute('data-theme', theme);
				} catch (e) {
					/* Private mode can throw on localStorage. The markup default stands. */
				}
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<!-- Starting value only. The theme script rewrites this from the computed
		     --bg whenever the theme changes, so the browser chrome cannot drift from
		     the palette the way a second hard-coded hex would. -->
		<meta name="theme-color" content="#F0EEE9" />
		<meta name="author" content="Steven Vanden Heuvel" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
		{ADOBE_KIT_ID && <link rel="stylesheet" href={`https://use.typekit.net/${ADOBE_KIT_ID}.css`} />}
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="Steven Design Co." />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		{description && <meta name="twitter:description" content={description} />}
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={title} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		{enableGA && (
			<>
				<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
				<script is:inline define:vars={{ GA_ID }}>
					window.dataLayer = window.dataLayer || [];
					function gtag(){dataLayer.push(arguments);}
					gtag('js', new Date());
					gtag('config', GA_ID);
				</script>
			</>
		)}
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<header class="site-header">
			<a class="brand" href="/">
				<img class="brand__mark" src="/images/brand/SDC_initialLogo.svg" alt="Steven Vanden Heuvel home" width="40" height="24" />
			</a>
			<nav class="nav" aria-label="Main">
				<a href={isHome ? '#work' : '/#work'}>Work</a>
				<a href={isHome ? '#design-systems' : '/#design-systems'}>Design systems</a>
				<a href={isHome ? '#about' : '/#about'}>About</a>
				<a href={isHome ? '#contact' : '/#contact'}>Contact</a>
				<a class="nav__cta" href="/resume">Resume</a>
			</nav>
			<button class="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
				<span class="nav-toggle__bar"></span>
				<span class="nav-toggle__bar"></span>
				<span class="nav-toggle__bar"></span>
			</button>
		</header>

		<nav id="mobile-nav" class="nav-mobile" aria-label="Mobile">
			<a href={isHome ? '#work' : '/#work'}>Work</a>
			<a href={isHome ? '#design-systems' : '/#design-systems'}>Design systems</a>
			<a href={isHome ? '#about' : '/#about'}>About</a>
			<a href={isHome ? '#contact' : '/#contact'}>Contact</a>
			<a href="/resume">Resume</a>
		</nav>

		<main id="main" class:list={[variant === 'case' && 'case']} tabindex="-1">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="site-footer__inner">
				<a class="brand brand--footer" href="/">
					<img src="/images/brand/SDC_initialLogo.svg" alt="" width="36" height="22" />
					<span>Steven Design Services LLC</span>
				</a>
				<div class="site-footer__meta">
					<span>© Steven Vanden Heuvel</span>
					<a class="js-email" data-eml="73746576656e4073746576656e64657369676e636f2e636f6d" href="#">steven [at] stevendesignco [dot] com</a>
				</div>
			</div>
		</footer>

		<!-- The icon shows the theme you would switch TO, which is why the sun
		     appears in dark mode. There is no visible text, so the name comes from
		     aria-label, and the script keeps that label in step with the state.
		     Hidden entirely without JavaScript, since it would do nothing. -->
		<button class="theme-toggle theme-toggle--float" type="button" id="theme-toggle" aria-label="Switch to dark theme">
			<svg class="theme-toggle__sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2 12h2M20 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
			<svg class="theme-toggle__moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.8 6.8 0 0 0 10.5 10.5Z"/></svg>
			<span class="theme-toggle__label">Theme</span>
		</button>

		<script>
			// Planned degradation: this class only exists when the bundled JS
			// actually loads. Every JS-dependent initial state (hidden fade
			// sections, hidden nav links, dead controls) is gated on html.js in
			// the CSS, so a blocked or failed script leaves a usable page.
			document.documentElement.classList.add('js');

			// Theme toggle. The pre-paint script in <head> has already set the
			// attribute; this only handles changing it and remembering the choice.
			const themeToggle = document.getElementById('theme-toggle');
			if (themeToggle) {
				const labelFor = (theme: string) =>
					theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme';
				const apply = (theme: string, remember: boolean) => {
					document.documentElement.setAttribute('data-theme', theme);
					themeToggle.setAttribute('aria-label', labelFor(theme));
					const meta = document.querySelector('meta[name="theme-color"]');
					if (meta) {
						const bg = getComputedStyle(document.documentElement).getPropertyValue('--bg').trim();
						if (bg) meta.setAttribute('content', bg);
					}
					if (remember) {
						try { localStorage.setItem('theme', theme); } catch (e) { /* private mode */ }
					}
				};
				apply(document.documentElement.getAttribute('data-theme') || 'light', false);
				themeToggle.addEventListener('click', () => {
					const next =
						document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
					apply(next, true);
				});
				// Follow the system until someone states a preference of their own.
				const os = window.matchMedia('(prefers-color-scheme: dark)');
				os.addEventListener('change', (e) => {
					let stored = null;
					try { stored = localStorage.getItem('theme'); } catch (err) { /* private mode */ }
					if (stored !== 'light' && stored !== 'dark') apply(e.matches ? 'dark' : 'light', false);
				});
			}

			// Fade-in on scroll
			const els = document.querySelectorAll<HTMLElement>('[data-animate="fade"]');
			if (els.length && 'IntersectionObserver' in window) {
				const io = new IntersectionObserver((entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							io.unobserve(entry.target);
						}
					});
				}, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
				els.forEach((el) => io.observe(el));
			} else {
				els.forEach((el) => el.classList.add('is-visible'));
			}

			// Mobile nav toggle
			const navToggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
			const navMobile = document.querySelector<HTMLElement>('#mobile-nav');
			if (navToggle && navMobile) {
				const setOpen = (open: boolean) => {
					navMobile.dataset.open = String(open);
					navToggle.setAttribute('aria-expanded', String(open));
					navToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
					document.body.classList.toggle('nav-open', open);
				};
				navToggle.addEventListener('click', () => {
					const open = navMobile.dataset.open !== 'true';
					setOpen(open);
					if (open) navMobile.querySelector('a')?.focus();
					else navToggle.focus();
				});
				navMobile.querySelectorAll('a').forEach((a) => {
					a.addEventListener('click', () => setOpen(false));
				});
				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape' && navMobile.dataset.open === 'true') { setOpen(false); navToggle.focus(); }
				});
			}

			// Email reveal: hex-decode data-eml at runtime so plain-text scrapers miss it
			document.querySelectorAll<HTMLAnchorElement>('a.js-email').forEach((a) => {
				const hex = a.dataset.eml;
				if (!hex) return;
				let email = '';
				for (let i = 0; i < hex.length; i += 2) {
					email += String.fromCharCode(parseInt(hex.substr(i, 2), 16));
				}
				a.href = 'mailto:' + email;
				a.textContent = email;
				const note = document.createElement('span');
				note.className = 'sr-only';
				note.textContent = ' (opens your email app)';
				a.appendChild(note);
			});
		</script>

		<script>
			// flip-links: wrap each menu + CTA link's text into two stacked letter rows
			(() => {
				const links = document.querySelectorAll('.nav-mobile a, .cta-row a');
				links.forEach((a) => {
					const text = (a.textContent || '').trim();
					if (!text) return;
					const makeRow = (cls, hidden) => {
						const row = document.createElement('span');
						row.className = 'flip__row ' + cls;
						if (hidden) row.setAttribute('aria-hidden', 'true');
						Array.from(text).forEach((ch, i) => {
							const s = document.createElement('span');
							s.className = 'flip__char';
							s.style.setProperty('--i', String(i));
							s.textContent = ch === ' ' ? ' ' : ch;
							row.appendChild(s);
						});
						return row;
					};
					const flip = document.createElement('span');
					flip.className = 'flip';
					flip.appendChild(makeRow('flip__row--top', false));
					flip.appendChild(makeRow('flip__row--bottom', true));
					a.textContent = '';
					a.appendChild(flip);
				});

				// Stack the CTA row and drop the "|" separators when it wraps to >1 line.
				const cta = document.querySelector('.cta-row');
				if (cta) {
					const checkWrap = () => {
						cta.classList.remove('cta-row--stacked');
						const items = cta.querySelectorAll('a');
						if (items.length < 2) return;
						const top0 = items[0].offsetTop;
						let wrapped = false;
						items.forEach((a) => { if (a.offsetTop !== top0) wrapped = true; });
						cta.classList.toggle('cta-row--stacked', wrapped);
					};
					checkWrap();
					window.addEventListener('resize', checkWrap);
					if (document.fonts && document.fonts.ready) document.fonts.ready.then(checkWrap);
				}

			})();
		</script>

		<style is:global>
			/* ---------- Tier 1: primitives ----------
			   Raw values, named for what they are rather than where they are used.
			   Nothing in the stylesheet may reference these directly except the
			   semantic tokens below. Changing the brand means changing a value
			   here, once.

			   The -rgb pairs exist because a rule or a glow needs the channels
			   without the alpha, so a translucent value can be built from the same
			   source as its solid one instead of being written out again. */
			:root {
				/* TOKENS:START — generated from Figma by scripts/build-tokens.mjs. Do not edit. */
				--brand-citron: #CCFF00;
				--brand-citron-light: #F1FFB8;
				--brand-focus: #233552;   /* Keyboard focus ring, light theme. Independent of brand hover values. */
				--brand-focus-dark: #F1FFB8;   /* Keyboard focus ring, dark theme. Independent of brand hover values. */
				--brand-regatta: #3F5F92;
				--brand-regatta-deep: #233552;
				--ink-black: #000000;
				--ink-charcoal: #2D3436;
				--ink-charcoal-mute: #545B5A;   /* Muted body text in the light theme. Darkened from #5A6160 on 2026-10-05 so it clears 4.5:1 on surface-2, the deepest light ground, and not only on the page background. */
				--ink-gray-mute: #8A8F8C;   /* Muted body text in the dark theme. US spelling: gray, not grey. */
				--ink-near-black: #111111;
				--ink-near-black-2: #1A1A1A;
				--paper-cloud: #F0EEE9;
				--paper-cloud-2: #E4E1DA;
				--paper-cloud-3: #D8D4CB;
				--paper-white: #FFFFFF;

				/* rgb triples for rgba() in the semantic tier */
				--brand-citron-rgb: 204, 255, 0;
				--brand-citron-light-rgb: 241, 255, 184;
				--brand-focus-rgb: 35, 53, 82;
				--brand-focus-dark-rgb: 241, 255, 184;
				--brand-regatta-rgb: 63, 95, 146;
				--brand-regatta-deep-rgb: 35, 53, 82;
				--ink-black-rgb: 0, 0, 0;
				--ink-charcoal-rgb: 45, 52, 54;
				--ink-charcoal-mute-rgb: 84, 91, 90;
				--ink-gray-mute-rgb: 138, 143, 140;
				--ink-near-black-rgb: 17, 17, 17;
				--ink-near-black-2-rgb: 26, 26, 26;
				--paper-cloud-rgb: 240, 238, 233;
				--paper-cloud-2-rgb: 228, 225, 218;
				--paper-cloud-3-rgb: 216, 212, 203;
				--paper-white-rgb: 255, 255, 255;
				/* TOKENS:END */
			}

			/* ---------- Tier 2: semantic ----------
			   What a thing is for, not what colour it is. Every rule in this
			   stylesheet uses these. Each theme maps them onto the primitives
			   above and introduces no new values of its own. */
			:root {
				color-scheme: light dark;

				/* dark theme, the base */
				--bg: var(--ink-black);
				--surface: var(--ink-near-black);
				--surface-2: var(--ink-near-black-2);
				--text: var(--paper-white);
				--text-mute: var(--ink-gray-mute);
				--rule: rgba(var(--paper-white-rgb), 0.20);
				--rule-soft: rgba(var(--paper-white-rgb), 0.10);
				--rule-strong: rgba(var(--paper-white-rgb), 0.42);   /* clears 3:1 */
				--texture-dot: rgba(var(--paper-white-rgb), 0.07);
				--texture-size: 20px;
				--accent: var(--brand-citron);
				--accent-text: var(--ink-black);
				--accent-hover: var(--brand-citron-light);
				--focus-ring: var(--brand-focus-dark);
				--accent-glow: rgba(var(--brand-citron-rgb), 0.20);
				--header-bg: rgba(var(--ink-black-rgb), 0.78);

				/* layout tokens (from Layout Tokens) */
				--max: 1280px;            /* layout/content-width */
				--max-narrow: 800px;      /* layout/content-narrow */
				--gutter: 24px;           /* layout/content-padding */
				--nav-h: 56px;            /* layout/nav-height */
				--radius: 18px;
				--radius-sm: 10px;

				/* spacing tokens (from Spacing Tokens) */
				--space-xs: 8px;
				--space-sm: 16px;
				--space-md: 24px;
				--space-lg: 32px;
				--space-xl: 48px;
				--space-2xl: 64px;
				--space-3xl: 96px;
				--space-4xl: 128px;
				--space-5xl: 160px;

				/* type-scale tokens (from Typography Tokens) */
				--font-display: 'nickel-gothic-variable', 'Inter', system-ui, sans-serif;
				--font-body: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
				--text-display-1: clamp(48px, 8vw, 96px);   /* hero headlines */
				--text-display-2: clamp(32px, 4.8vw, 48px); /* section titles */
				--text-heading: clamp(24px, 3.2vw, 32px);   /* case study titles */
				--text-deck: clamp(18px, 1.9vw, 24px);      /* taglines, intros */
				--text-subheading: 20px;                    /* section labels */
				--text-body: 16px;                          /* paragraph */
				--text-nav: 15px;                           /* navigation */
				--text-body-sm: 14px;                       /* captions */
				--text-label: 11px;                         /* tags, metadata */

				/* Sizes the layout actually ships that the nine above did not cover.
				   Same clamps, named. Added after binding the Figma library left
				   them matching no token. */
				--text-case-title: clamp(32px, 9vw, 56px);    /* case study hero title */
				--text-block-lede: clamp(24px, 2.5vw, 32px);  /* the claim in a case block */
				--text-quote: clamp(20px, 2vw, 28px);         /* pulled quote */
				--text-stat: clamp(40px, 5vw, 64px);          /* stat number */
				--text-stat-lg: clamp(48px, 6vw, 72px);       /* stat number, closing statement */

				/* ---------- Elevation ----------
				   Cards carry a four-stop shadow and deepen on hover. Nothing else
				   on the site is elevated; if something new needs a shadow, ask
				   first whether it should be a card.

				   Both themes use the same charcoal, which is what shipped when
				   these lived in the home page's own <style> block. On the dark
				   ground a charcoal shadow reads as almost nothing, and that is
				   correct: in dark mode the elevation comes from --surface being
				   lighter than --bg, not from the shadow. */
				--shadow-card: 0 1px 2px rgba(var(--ink-charcoal-rgb), 0.08), 0 6px 12px -4px rgba(var(--ink-charcoal-rgb), 0.14), 0 18px 32px -12px rgba(var(--ink-charcoal-rgb), 0.24), 0 36px 64px -24px rgba(var(--ink-charcoal-rgb), 0.32);
				--shadow-card-hover: 0 1px 2px rgba(var(--ink-charcoal-rgb), 0.08), 0 10px 18px -6px rgba(var(--ink-charcoal-rgb), 0.18), 0 26px 44px -14px rgba(var(--ink-charcoal-rgb), 0.3), 0 48px 80px -28px rgba(var(--ink-charcoal-rgb), 0.38);
			}

			/* Light theme: applied when system requests light AND user has not
			   explicitly chosen dark, OR when user has explicitly chosen light. */
			/* Light theme: Atmospheric palette (Pantone candidate, June 2026).
			   Warm Cloud Dancer paper, charcoal body text, Regatta blue as the
			   single accent. Dusky Citron #E2C56E is the optional warm pop. */
			/* Light theme. Warm Cloud Dancer paper, charcoal body text, Regatta blue
			   as the single accent. Written once: the attribute is always present,
			   set before paint by the script in <head>, so there is no second copy
			   behind a prefers-color-scheme query to keep in step. */
			:root[data-theme="light"] {
				color-scheme: light;
				--bg: var(--paper-cloud);
				--surface: var(--paper-cloud-2);
				--surface-2: var(--paper-cloud-3);
				--text: var(--ink-charcoal);
				--text-mute: var(--ink-charcoal-mute);
				--rule: rgba(var(--ink-charcoal-rgb), 0.20);
				--rule-soft: rgba(var(--ink-charcoal-rgb), 0.10);
				--rule-strong: rgba(var(--ink-charcoal-rgb), 0.58);   /* clears 3:1 */
				--texture-dot: rgba(var(--ink-charcoal-rgb), 0.10);
				--texture-size: 20px;
				--accent: var(--brand-regatta);
				--accent-text: var(--paper-white);
				--accent-hover: var(--brand-regatta-deep);
				--focus-ring: var(--brand-focus);
				--accent-glow: rgba(var(--brand-regatta-rgb), 0.22);
				--header-bg: rgba(var(--paper-cloud-rgb), 0.82);
			}
			* { box-sizing: border-box; }
			html, body { margin: 0; padding: 0; }
			/* Stop Android/iOS from auto-inflating text, which on some phones
			   enlarged the hero name and subhead until they ran off the frame. */
			html {
				background: var(--bg);
				-webkit-text-size-adjust: 100%;
				text-size-adjust: 100%;
				scroll-behavior: smooth;
			}
			/* The header is sticky, so anything scrolled into view (a focused link,
			   an anchor target) is offset below it rather than hidden behind it. */
			html { scroll-padding-top: var(--nav-h); }
			@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
			body {
				/* Dot-grid page grain, ported from the 21st.dev noise texture to the
				   site's own tokens. Turn it up or down with --texture-dot. */
				background-color: var(--bg);
				background-image: radial-gradient(circle at 1px 1px, var(--texture-dot) 1px, transparent 0);
				background-size: var(--texture-size) var(--texture-size);
				color: var(--text);
				font-family: var(--font-body);
				font-size: var(--text-body);
				line-height: 1.6;
				overflow-x: clip;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
			}
			/* Focus. The browser default is a blue ring that reads as a selected
			   state and is off-palette, so the ring is the page's own ink: high
			   contrast against both grounds and identical in both themes. Only
			   :focus-visible, so a mouse click never draws it. */
			:focus-visible { outline: 3px solid var(--focus-ring); outline-offset: 3px; }
			:focus:not(:focus-visible) { outline: none; }
			.no-ring:focus, .no-ring:focus-visible { outline: none; }
			/* Windows High Contrast: let the system draw its own ring. */
			/* Users asking for more contrast get the muted tones collapsed into the ink. */
			@media (prefers-contrast: more) {
				:root, :root[data-theme="light"] { --text-mute: var(--text); --rule: var(--rule-strong); }
			}
			/* Text for assistive tech only: visually removed, still read aloud. */
			.sr-only { position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap; border: 0; }
			.skip-link {
				position: absolute; left: 12px; top: -64px; z-index: 200;
				display: inline-flex; align-items: center; height: 44px; padding: 0 18px;
				background: var(--text); color: var(--bg); border-radius: 10px;
				font-family: var(--font-body); font-size: 15px; font-weight: 600;
				transition: top 0.12s ease;
			}
			.skip-link:focus { top: 12px; color: var(--bg); }
			main:focus { outline: none; }
			::selection { background: var(--accent); color: var(--accent-text); }
			a { color: var(--accent); text-decoration: none; }
			a:hover { text-decoration: none; }

			h1, h2, h3 { color: var(--text); margin: 0; line-height: 1.1; letter-spacing: -0.022em; font-weight: 700; }
			h1 { font-size: var(--text-display-1); line-height: 0.98; letter-spacing: -0.03em; }
			h2 {
				font-family: var(--font-display);
				font-variation-settings: "wght" 700, "slnt" 0, "ital" 0;
				font-synthesis: none;
				font-size: var(--text-display-2);
				line-height: 1.04;
				letter-spacing: -0.025em;
			}
			h3 {
				font-family: var(--font-display);
				font-size: 18px;
				font-weight: 900;
				font-style: normal;
				font-variation-settings: "wght" 900, "slnt" 0, "ital" 0;
				font-synthesis: none;
				line-height: 1.1;
				letter-spacing: 0.01em;
				color: var(--text);
			}
			p { margin: 0 0 1em; }
			img, svg { display: block; max-width: 100%; }

			/* Display style: Nickel Gothic Variable, normal weight, upright */
			.display {
				font-family: var(--font-display);
				font-weight: 400;
				font-style: normal;
				font-variation-settings: "wght" 400, "slnt" 0, "ital" 0;
				font-synthesis: none;
				letter-spacing: normal;
				line-height: 0.96;
			}

			.eyebrow {
				font-size: var(--text-label);
				letter-spacing: 0.16em;
				text-transform: uppercase;
				color: var(--text);
				margin: 0 0 var(--space-md);
				font-weight: 700;
			}
			.eyebrow--mute { color: var(--text-mute); }

			/* Header */
			.site-header {
				position: sticky;
				top: 0;
				z-index: 30;
				display: flex;
				align-items: center;
				justify-content: space-between;
				height: var(--nav-h);
				padding: 0 var(--gutter);
				background: var(--header-bg);
				-webkit-backdrop-filter: saturate(180%) blur(14px);
				backdrop-filter: saturate(180%) blur(14px);
				border-bottom: 1px solid var(--rule-soft);
			}
			.brand {
				display: inline-flex;
				align-items: center;
				gap: 14px;
				color: var(--text);
				letter-spacing: -0.01em;
				font-weight: 600;
				font-size: var(--text-body);
			}
			.brand:hover { color: var(--text); }
			.brand__mark { display: block; height: 24px; width: auto; }
			/* SDC mark SVG has hardcoded lime fills — invert to black in light mode */
			:root[data-theme="light"] .brand img { filter: brightness(0); }
			.nav { display: flex; align-items: center; gap: var(--space-lg); }
			.nav a {
				color: var(--text);
				font-size: var(--text-nav);
				font-weight: 500;
				transition: color 0.12s ease, opacity 0.12s ease;
				opacity: 0.8;
			}
			.nav a:hover { color: var(--text); opacity: 1; }
			.nav__cta {
				padding: 8px 16px;
				border-radius: 10px;
				border: 1px solid var(--rule-strong);
				color: var(--text) !important;
				opacity: 1 !important;
				transition: background 0.14s ease, border-color 0.14s ease, color 0.14s ease;
			}
			.nav__cta:hover { background: var(--accent); color: var(--accent-text) !important; border-color: var(--accent); }

			/* Theme toggle (sun/moon) — floating in bottom-right corner */
			.theme-toggle {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				background: var(--bg);
				border: 1px solid var(--rule-strong);
				border-radius: 999px;
				color: var(--text);
				cursor: pointer;
				padding: 0;
				transition: border-color 0.14s ease, color 0.14s ease, background 0.14s ease, transform 0.12s ease;
			}
			.theme-toggle:hover { border-color: var(--text); color: var(--text); transform: translateY(-1px); }
			.theme-toggle__sun, .theme-toggle__moon { display: block; }
			.theme-toggle__label { display: none; }

			.theme-toggle--float {
				position: fixed;
				right: 20px;
				bottom: 20px;
				z-index: 40;
				width: 48px;
				height: 48px;
				box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
				-webkit-backdrop-filter: blur(8px);
				backdrop-filter: blur(8px);
			}
			@media (max-width: 600px) {
				.theme-toggle--float { right: 16px; bottom: 16px; width: 44px; height: 44px; }
			}
			/* Dark theme: show sun icon (click → switch to light) */
			.theme-toggle__moon { display: none; }
			/* Light theme: show moon icon (click → switch to dark) */
			:root[data-theme="light"] .theme-toggle__sun { display: none; }
			:root[data-theme="light"] .theme-toggle__moon { display: block; }
			:root[data-theme="dark"] .theme-toggle__sun { display: block; }
			:root[data-theme="dark"] .theme-toggle__moon { display: none; }

			/* Hamburger toggle (mobile) */
			.nav-toggle {
				display: none;
				width: 40px;
				height: 40px;
				margin-right: -8px;
				background: none;
				border: none;
				padding: 8px;
				cursor: pointer;
				flex-direction: column;
				justify-content: space-between;
				align-items: stretch;
			}
			.nav-toggle__bar {
				display: block;
				height: 2px;
				background: var(--text);
				border-radius: 2px;
				transition: transform 0.18s ease, opacity 0.18s ease;
				transform-origin: center;
			}
			.nav-toggle[aria-expanded="true"] .nav-toggle__bar:nth-child(1) {
				transform: translateY(11px) rotate(45deg);
			}
			.nav-toggle[aria-expanded="true"] .nav-toggle__bar:nth-child(2) { opacity: 0; }
			.nav-toggle[aria-expanded="true"] .nav-toggle__bar:nth-child(3) {
				transform: translateY(-11px) rotate(-45deg);
			}

			/* Mobile nav overlay */
			.nav-mobile {
				display: none;
				position: fixed;
				top: var(--nav-h);
				left: 0;
				right: 0;
				bottom: 0;
				background: var(--bg);
				flex-direction: column;
				padding: var(--space-md) var(--gutter) var(--space-2xl);
				z-index: 25;
				border-top: 1px solid var(--rule-soft);
				overflow-y: auto;
			}
			.nav-mobile[data-open="true"] { display: flex; }
			.nav-mobile a {
				display: block;
				padding: var(--space-md) 0;
				font-family: var(--font-display);
				font-weight: 400;
				font-style: normal;
				font-variation-settings: "wght" 400, "slnt" 0, "ital" 0;
				font-synthesis: none;
				font-size: clamp(28px, 6vw, 40px);
				color: var(--text);
				border-bottom: 1px solid var(--rule);
				letter-spacing: normal;
				line-height: 1.1;
			}
			.nav-mobile a:hover,
			.nav-mobile a:focus-visible { color: var(--accent); }
			body.nav-open { overflow: hidden; }

			/* flip-links: per-letter vertical roll on hover, revealing the accent color */
			.flip { position: relative; display: inline-block; overflow: hidden; vertical-align: top; }
			.flip__row { display: flex; }
			.flip__row--top { color: var(--text); }
			.flip__row--bottom { position: absolute; left: 0; top: 0; color: var(--accent); }
			.flip__char {
				display: inline-block;
				white-space: pre;
				transform: translateY(0);
				transition: transform .45s cubic-bezier(.76, 0, .24, 1);
				transition-delay: calc(var(--i) * 18ms);
			}
			.flip__row--bottom .flip__char { transform: translateY(105%); }
			.nav-mobile a:hover .flip__row--top .flip__char,
			.nav-mobile a:focus-visible .flip__row--top .flip__char,
			.cta-row a:hover .flip__row--top .flip__char,
			.cta-row a:focus-visible .flip__row--top .flip__char { transform: translateY(-105%); }
			.nav-mobile a:hover .flip__row--bottom .flip__char,
			.nav-mobile a:focus-visible .flip__row--bottom .flip__char,
			.cta-row a:hover .flip__row--bottom .flip__char,
			.cta-row a:focus-visible .flip__row--bottom .flip__char { transform: translateY(0); }
			@media (prefers-reduced-motion: reduce) { .flip__char { transition: none; } }

			/* card titles: per-letter roll on card hover (same as CTA links; multi-line safe
			   because each letter is its own clipped unit and words wrap at spaces) */
			.cflip { display: inline; }
			.cflip-word { display: inline-block; white-space: nowrap; vertical-align: top; }
			.cflip-space { white-space: pre; }
			.cflip-char { position: relative; display: inline-block; overflow: hidden; vertical-align: top; }
			.cflip-char > span { display: block; transition: transform 0.42s cubic-bezier(0.76, 0, 0.24, 1); transition-delay: calc(var(--i) * 16ms); }
			.cflip-char > span:last-child { position: absolute; left: 0; top: 0; transform: translateY(100%); color: var(--accent); }
			.card:hover .cflip-char > span:first-child,
			.card:focus-visible .cflip-char > span:first-child { transform: translateY(-100%); }
			.card:hover .cflip-char > span:last-child,
			.card:focus-visible .cflip-char > span:last-child { transform: translateY(0); }
			@media (prefers-reduced-motion: reduce) { .cflip-char > span { transition: none; } }

			/* Sections (shared) */
			.section { padding: var(--space-2xl) var(--gutter); }
			.section--alt { background: var(--bg); }

			/* Theme-aware image swap: pair a .theme-img--dark with .theme-img--light,
			   the browser will paint whichever matches the active theme.
			   !important is used so these win over scoped page styles that target img. */
			.theme-img--light { display: none !important; }
			:root[data-theme="light"] .theme-img--dark { display: none !important; }
			:root[data-theme="light"] .theme-img--light { display: block !important; }
			:root[data-theme="dark"] .theme-img--dark { display: block !important; }
			:root[data-theme="dark"] .theme-img--light { display: none !important; }

			/* Fade-in on scroll, observed via tiny script at end of body.
			   Gated on html.js: if the bundled script never loads (blocked
			   network, proxy), sections stay visible instead of opacity 0. */
			html.js [data-animate="fade"] {
				opacity: 0;
				transform: translateY(12px);
				transition: opacity 0.8s ease-out, transform 0.8s ease-out;
			}
			html.js [data-animate="fade"].is-visible {
				opacity: 1;
				transform: translateY(0);
			}
			@media (prefers-reduced-motion: reduce) {
				html.js [data-animate="fade"] { opacity: 1; transform: none; transition: none; }
			}

			/* No-JS fallbacks: plain link nav instead of the dead hamburger,
			   no dead theme toggle, email link reads as text (the address is
			   already human readable in the anchor text). */
			html:not(.js) .nav { display: flex; flex-wrap: wrap; }
			html:not(.js) .nav-toggle { display: none; }
			html:not(.js) .theme-toggle { display: none; }
			html:not(.js) a.js-email { pointer-events: none; text-decoration: none; cursor: default; }
			.section--ink { background: var(--bg); }
			.section__inner { max-width: var(--max); margin: 0 auto; }
			.section__inner--narrow { max-width: var(--max-narrow); }
			.prose { max-width: var(--max-narrow); font-size: 18px; color: var(--text); line-height: 1.7; font-weight: 400; }
			.prose p { margin: 0 0 1.2em; }
			.prose strong { color: var(--text); font-weight: 600; }

			/* Buttons */
			.btn {
				display: inline-flex;
				align-items: center;
				gap: var(--space-xs);
				/* 16/24, matching the Figma Button, and on the spacing scale rather
				   than the old off-scale 14/22. */
				padding: var(--space-sm) var(--space-md);
				border-radius: var(--radius-sm);
				border: 1px solid var(--rule-strong);
				background: transparent;
				color: var(--text);
				font-family: var(--font-body);
				font-size: var(--text-nav);
				font-weight: 600;
				letter-spacing: -0.005em;
				transition: background 0.14s ease, border-color 0.14s ease, color 0.14s ease, transform 0.12s ease;
				cursor: pointer;
			}
			.btn:hover { border-color: var(--text); transform: translateY(-1px); }
			.btn--primary { background: var(--accent); color: var(--accent-text); border-color: var(--accent); }
			.btn--primary:hover {
				background: var(--accent-hover);
				border-color: var(--accent-hover);
				color: var(--accent-text);
				box-shadow: 0 14px 40px -10px var(--accent-glow);
			}

			@media print {
				.site-header, .site-footer, .nav-mobile, .theme-toggle { display: none !important; }
				/* Paper is white and ink is black whatever the screen theme is, so these
				   name the primitives directly rather than the semantic tokens. */
				html, body { background: var(--paper-white) !important; color: var(--ink-black); }
				a { color: inherit; text-decoration: none; }
			}

			/* Pager: a solid button with the chevron in a tinted end cap. */
			.pager {
				position: relative;
				display: inline-flex;
				align-items: center;
				height: 42px;
				padding: 0 54px 0 18px;
				border-radius: 10px;
				background: var(--text);
				color: var(--bg);
				font-family: var(--font-body);
				font-size: 14px;
				font-weight: 600;
				letter-spacing: -0.005em;
				overflow: hidden;
				transition: background 0.15s ease, color 0.15s ease;
			}
			.pager--prev { padding: 0 18px 0 54px; }
			.pager:hover { background: var(--accent); color: var(--accent-text); }
			.pager__cap {
				position: absolute;
				top: 0;
				bottom: 0;
				right: 0;
				width: 42px;
				display: flex;
				align-items: center;
				justify-content: center;
				background: rgba(240, 238, 233, 0.16);
			}
			.pager--prev .pager__cap { right: auto; left: 0; }
			.pager__cap svg { width: 16px; height: 16px; display: block; opacity: 0.6; }

			/* ---------- Case study pages ----------
			   Each of these was written out in every case study page file, up to
			   eight copies. They live here once. Media context is preserved exactly;
			   moving a rule between breakpoints changes the design.

			   Everything here is under .case, which Site puts on <main> when a page
			   passes variant="case". Without it these selectors would reach the home
			   page, the work index and the resume, which use .section and .eyebrow
			   too and style them differently. */
			.case .cs-hero { max-width: var(--max); margin: 0 auto; padding: var(--space-2xl) var(--gutter); }
			.case .cs-back-top { display: inline-flex; align-items: center; min-height: 24px; margin-bottom: var(--space-lg); color: var(--text-mute); font-size: var(--text-body-sm); }
			.case .cs-back-top:hover { color: var(--accent); }
			.case .cs-hero__title { margin: var(--space-xs) 0 var(--space-lg); max-width: 20ch; }
			.case .cs-hero__lede { font-size: var(--text-deck); color: var(--text); line-height: 1.5; max-width: 56ch; margin-bottom: var(--space-2xl); font-weight: 500; }
			.case .cs-meta { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-md); margin: 0; padding: var(--space-lg) 0 0; border-top: 1px solid var(--rule); }
			.case .cs-meta div { margin: 0; }
			.case .cs-meta dt { font-size: var(--text-label); letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-mute); font-weight: 800; margin-bottom: var(--space-xs); }
			.case .cs-meta dd { margin: 0; color: var(--text); font-size: var(--text-body); font-weight: 500; }
			.case .cs-figure { max-width: 100%; margin: var(--space-lg) 0 var(--space-xl); }
			.case .cs-figure img { width: 100%; height: auto; display: block; }
			.case .section { padding-top: var(--space-xl); padding-bottom: var(--space-xl); }
			.case .cs-body { display: grid; gap: var(--space-xl); max-width: var(--max-narrow); }
			.case .cs-block .eyebrow { margin-bottom: 0; }
			.case .eyebrow { font-family: var(--font-display); font-weight: 400; font-variation-settings: "wght" 400, "slnt" 0, "ital" 0; font-synthesis: none; letter-spacing: 0.03em; }
			.case .cs-block__lede { color: var(--text); font-size: var(--text-block-lede); font-weight: 600; margin: 0; letter-spacing: -0.015em; line-height: 1.25; }
			.case .cs-block p { color: var(--text-mute); margin: 0; font-size: 16px; line-height: 1.65; }
			.case .cs-block p + p { margin-top: 0; }
			.case .cs-block p:not(.eyebrow):not(.cs-block__lede) + p:not(.eyebrow):not(.cs-block__lede) { margin-top: var(--space-sm); }
			.case .cs-awards { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
			.case .cs-awards li { display: flex; gap: var(--space-md); align-items: center; padding: var(--space-md) 0; border-top: 1px solid var(--rule); font-size: 18px; }
			.case .cs-awards li:last-child { border-bottom: 1px solid var(--rule); }
			.case .cs-awards__mark { display: none; }
			.case .cs-artifacts { display: flex; gap: var(--space-lg); flex-wrap: wrap; margin-top: var(--space-md); }
			.case .cs-artifacts .btn { min-height: 24px; display: inline-flex; align-items: center; }
			.case .cs-back { display: flex; gap: var(--space-sm); flex-wrap: wrap; justify-content: space-between; align-items: center; }
			.case .cs-back .btn--primary { background: var(--text); color: var(--bg); border-color: var(--text); }
			.case .cs-back .btn--primary:hover { background: var(--text); border-color: var(--text); color: var(--bg); box-shadow: none; }
			.case .cs-artifacts .btn, .case .cs-back .btn, .case .cs-back .btn--primary { padding: 0; border: 0; border-radius: 0; background: transparent; color: var(--text); font-family: var(--font-body); font-weight: 600; font-size: 15px; letter-spacing: 0; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; transform: none; box-shadow: none; }
			.case .cs-artifacts .btn:hover, .case .cs-back .btn:hover, .case .cs-back .btn--primary:hover { color: var(--accent); background: transparent; border: 0; transform: none; box-shadow: none; }
			.case .cs-note { margin: var(--space-md) 0 0; padding: 0; border: 0; font-family: var(--font-body); font-weight: 400; font-size: 14px; line-height: 1.6; letter-spacing: 0.04em; color: var(--text-mute); max-width: 64ch; }
			.case .cs-block strong { color: var(--text); font-weight: 600; }
			.case .cs-caption { margin: var(--space-md) 0 0; color: var(--text-mute); font-size: 14px; letter-spacing: 0.04em; }
			.case .cs-figure__cap { margin: var(--space-sm) 0 0; color: var(--text-mute); font-size: 15px; line-height: 1.5; max-width: 62ch; }
