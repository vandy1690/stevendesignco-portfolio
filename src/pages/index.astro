<style>
	.hero {
		max-width: var(--max);
		margin: 0 auto;
		padding: 96px var(--gutter) 64px;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 64px;
		align-items: center;
		min-height: calc(100vh - 80px);
		overflow: hidden;
		overflow: clip;
	}
	.hero__title { margin-bottom: 28px; letter-spacing: -0.03em; }
	.hero__sub {
		font-size: clamp(20px, 1.8vw, 26px);
		color: var(--text);
		max-width: 32ch;
		margin-bottom: 16px;
		line-height: 1.35;
		font-weight: 500;
	}
	.hero__tagline {
		font-size: 16px;
		color: var(--text-mute);
		margin-bottom: 36px;
		letter-spacing: -0.005em;
	}
	.hero__tagline-mark { color: var(--lime); font-weight: 600; }
	.cta-row { display: flex; flex-wrap: nowrap; gap: 12px; }
	.cta-row .btn { white-space: nowrap; flex: 0 1 auto; min-width: 0; }
	.hero__art { min-width: 0; }

	.section__title {
		max-width: 22ch;
		margin: 0 0 56px;
		letter-spacing: -0.025em;
	}

	.about { display: grid; gap: 8px; }

	.marquee {
		position: relative;
		overflow-x: auto;
		overflow-y: hidden;
		margin-inline: calc(-1 * var(--gutter));
		mask-image: linear-gradient(to right, transparent 0, #000 5%, #000 95%, transparent 100%);
		-webkit-mask-image: linear-gradient(to right, transparent 0, #000 5%, #000 95%, transparent 100%);
		scrollbar-width: none;
		-ms-overflow-style: none;
		-webkit-overflow-scrolling: touch;
		cursor: grab;
	}
	.marquee:active { cursor: grabbing; }
	.marquee::-webkit-scrollbar { display: none; }
	.marquee__track {
		display: flex;
		width: max-content;
	}
	.marquee .card {
		flex: 0 0 360px;
		margin-right: 20px;
	}
	@media (prefers-reduced-motion: reduce) {
		.marquee { mask-image: none; -webkit-mask-image: none; }
	}
	@media (max-width: 600px) {
		.marquee .card { flex: 0 0 280px; margin-right: 16px; }
	}
	.card {
		background: var(--surface);
		border: 1px solid var(--rule);
		border-radius: var(--radius);
		color: var(--text);
		display: flex;
		flex-direction: column;
		overflow: hidden;
		transition: transform 0.22s ease, border-color 0.22s ease, background 0.22s ease;
	}
	.card:hover {
		transform: translateY(-4px);
		border-color: var(--lime);
		background: var(--surface-2);
		color: var(--text);
	}
	.card:hover .arrow { transform: translateX(6px); color: var(--lime); }
	.card__media {
		position: relative;
		aspect-ratio: 16 / 9;
		background-color: var(--surface);
		background-size: cover;
		background-position: center;
		display: flex;
		align-items: center;
		justify-content: center;
		border-bottom: 1px solid var(--rule);
	}
	.card__media--paypal { background-color: #60cdff; }
	.card__media--paypal img { width: 56%; max-width: 200px; }
	.card__media--photo::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(to bottom, transparent 50%, rgba(0,0,0,0.45) 100%);
	}
	.card__content { padding: 24px 24px 26px; display: flex; flex-direction: column; gap: 12px; flex: 1; }
	.card__role { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-mute); font-weight: 600; }
	.card__title { line-height: 1.1; }
	.card__body { color: var(--text); margin: 0; font-size: 15px; line-height: 1.5; flex: 1; }
	.card__cta {
		margin-top: 8px;
		color: var(--text);
		font-weight: 600;
		font-size: 14px;
		letter-spacing: 0.01em;
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}
	.arrow { display: inline-block; transition: transform 0.22s ease, color 0.22s ease; }

	.awards {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0 32px;
	}
	.awards li {
		display: flex;
		align-items: baseline;
		gap: 18px;
		padding: 22px 0;
		border-top: 1px solid var(--rule);
		color: var(--text);
		font-size: 16px;
	}
	.awards li:last-child:nth-child(3n) { border-bottom: none; }
	.awards strong {
		font-size: 36px;
		font-weight: 700;
		color: var(--lime);
		min-width: 44px;
		font-variant-numeric: tabular-nums;
		line-height: 1;
		letter-spacing: -0.02em;
	}
	.awards__dot { color: var(--lime); font-size: 22px; min-width: 44px; }

	.services {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}
	.services li {
		padding: 12px 18px;
		background: transparent;
		border: 1px solid var(--rule);
		border-radius: 999px;
		font-size: 15px;
		color: var(--text);
		font-weight: 500;
		transition: border-color 0.14s ease, color 0.14s ease;
	}
	.services li:hover { border-color: var(--lime); color: var(--lime); }

	.section--contact { padding: 160px var(--gutter); text-align: center; }
	.contact { display: flex; flex-direction: column; align-items: center; gap: 48px; }
	.contact__title {
		color: var(--text);
		font-size: clamp(56px, 8vw, 128px);
		margin: 0;
	}
	.contact__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; font-size: clamp(18px, 1.6vw, 24px); font-weight: 600; }
	.contact__list a {
		color: var(--text);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 4px;
		transition: color 0.14s ease;
	}
	.contact__list a:hover { color: var(--lime); }
	.contact__based { color: var(--text-mute); font-size: 14px; margin: 0; letter-spacing: 0.04em; }

	@media (max-width: 880px) {
		.hero { grid-template-columns: 1fr; padding-top: 48px; gap: 32px; min-height: 0; }
		.marquee { cursor: auto; }
		.hero__art {
			order: -1;
			width: 100%;
			aspect-ratio: 1 / 1;
			overflow: visible;
		}
		.cta-row { gap: 8px; }
		.cta-row .btn { padding: 11px 14px; font-size: 13px; }
		.awards { grid-template-columns: 1fr; }
		.contact__list li { grid-template-columns: 1fr; gap: 6px; padding: 18px 0; font-size: 17px; }
	}
</style>

<script>
	const marquee = document.querySelector<HTMLElement>('#work .marquee');
	if (marquee) {
		const SPEED = 40; // px per second
		const PAUSE_MS = 2200;
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let pausedUntil = reduced ? Infinity : 0;
		let last = performance.now();
		let halfWidth = 0;

		const measure = () => { halfWidth = marquee.scrollWidth / 2; };
		measure();
		new ResizeObserver(measure).observe(marquee);
		window.addEventListener('load', measure);
		if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);
		marquee.querySelectorAll('img').forEach((img) => {
			if (!img.complete) img.addEventListener('load', measure, { once: true });
		});

		const isPaused = () => performance.now() < pausedUntil || marquee.matches(':hover');
		const bumpPause = () => { pausedUntil = performance.now() + PAUSE_MS; };

		marquee.addEventListener('wheel', bumpPause, { passive: true });
		marquee.addEventListener('touchstart', bumpPause, { passive: true });
		marquee.addEventListener('keydown', bumpPause);

		// Drag-to-scroll on desktop (mouse only; touch scrolls natively).
		// Don't capture the pointer or treat anything as a drag until the mouse
		// has moved past a small threshold; clicks on cards still navigate.
		const DRAG_THRESHOLD = 5;
		let downX = 0;
		let downScroll = 0;
		let isDown = false;
		let isDrag = false;

		marquee.addEventListener('pointerdown', (e) => {
			bumpPause();
			if (e.pointerType !== 'mouse') return;
			isDown = true;
			isDrag = false;
			downX = e.clientX;
			downScroll = marquee.scrollLeft;
		});
		marquee.addEventListener('pointermove', (e) => {
			if (!isDown) return;
			const delta = e.clientX - downX;
			if (!isDrag && Math.abs(delta) > DRAG_THRESHOLD) isDrag = true;
			if (isDrag) {
				marquee.scrollLeft = downScroll - delta;
				bumpPause();
			}
		});
		const endDown = () => { isDown = false; };
		marquee.addEventListener('pointerup', endDown);
		marquee.addEventListener('pointercancel', endDown);

		// Suppress the synthetic click that follows a drag (otherwise the card
		// under the mouse navigates after a scroll-drag).
		marquee.addEventListener('click', (e) => {
			if (isDrag) {
				e.preventDefault();
				e.stopPropagation();
				isDrag = false;
			}
		}, true);

		const step = (now: number) => {
			const dt = now - last;
			last = now;
			if (halfWidth === 0) measure();
			if (halfWidth > 0) {
				if (!isPaused()) {
					let next = marquee.scrollLeft + (dt / 1000) * SPEED;
					if (next >= halfWidth) next -= halfWidth;
					marquee.scrollLeft = next;
				} else {
					if (marquee.scrollLeft >= halfWidth) marquee.scrollLeft -= halfWidth;
					else if (marquee.scrollLeft < 0) marquee.scrollLeft += halfWidth;
				}
			}
			requestAnimationFrame(step);
		};
		requestAnimationFrame(step);
	}
</script>
