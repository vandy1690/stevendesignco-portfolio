---
import Site from '../layouts/Site.astro';
import PluginPipeline from '../components/art/PluginPipeline.astro';
import OneClickCheckout from '../components/art/OneClickCheckout.astro';
import JourneyMap from '../components/art/JourneyMap.astro';

// Four case studies, one argument each. Order is a data decision: swap entries here.
// `image` is the full-bleed card image (16:9, 1600 by 900 or larger, object-fit cover).
// Until Steve supplies one, the drawn art stands in. Copy is one statement per card.
const cases = [
	{
		href: '/work/merchant-flow-builder',
		art: 'plugin',
		image: null,
		head: 'Nobody asked for this one.',
		text: 'A Figma plugin, built on my own initiative, that cut merchant flow setup from most of a day to 10 to 15 minutes.',
		product: 'Figma plugin, PayPal',
		objective: 'Faster merchant flow setup',
	},
	{
		href: '/design-systems',
		art: 'image',
		image: '/images/case-studies/design-systems/pattern-lab.webp',
		anchor: 'design-systems',
		head: 'One library, seven brands.',
		text: 'Two Pattern Labs, two Storybook builds, and a Figma library of about 600 component variants, all still browsable.',
		product: 'Design systems, MTG Media Group and PayPal',
		objective: 'Keep the quality up after the first version ships',
	},
	{
		href: '/work/paypal',
		art: 'checkout',
		image: null,
		head: 'Becoming the default at checkout.',
		text: '20+ merchant proposal packages for the one-click program, each with a working prototype, on weekly sprints.',
		product: 'One-click checkout, PayPal',
		objective: 'One tap in each merchant’s own checkout',
	},
	{
		href: '/work/plate',
		art: 'image',
		image: '/images/case-studies/plate/plate-scene.webp',
		head: 'One rebuilt, one built from nothing.',
		text: 'Plate grew from a recipe database into a full content platform and won the 2017 Jesse H. Neal Award for Best Website. Alt-Meat launched from zero in under 8 weeks and reached 22,000 registered users.',
		product: 'Plate and Alt-Meat, MTG Media Group',
		objective: 'Responsive products on their own design systems',
	},
	{
		href: '/work/paypal#checkout-dead-end',
		art: 'journey',
		image: null,
		head: 'The checkout dead end.',
		text: 'The journey a customer takes when a saved card stops working, mapped for senior leadership and now the team’s template.',
		product: 'PayPal consumer checkout',
		objective: 'Show leadership where the dead end starts',
	},
];

// Recommendations. One verbatim sentence from each of the twelve LinkedIn
// recommendations, pasted by Steve on September 11, 2026. Titles only, no names,
// and no sentence that carries an em dash or a claim the site does not make
// elsewhere. Titles marked (inferred) come from the writer's headline, not a
// confirmed job title at the time.
const RECS_URL = 'https://www.linkedin.com/in/stevendesignco/details/recommendations/';
const quotes = [
	{ text: 'He created a novel design intake process that allowed the team to accelerate production, and developed a unique workflow for producing first-draft designs.', title: 'Senior Design Program Manager, PayPal' },
	{ text: 'He used AI tools to work faster, but traditional know-how and design excellence to deliver a product-wide audit and analysis that was shown to the c-suite and directly affected the company\u2019s roadmap.', title: 'Content Designer, PayPal' },
	{ text: 'He is one of those uncommon designers who can move fluidly between strategy, design, prototyping, and code.', title: 'Product Designer, PayPal Merchant Enablement' },
	{ text: 'Early on, he found, learned and implemented responsive design for all our web-based products. This saved an incredible amount of time and money and positioned us ahead of all our competitors.', title: 'President and Owner, MTG Media Group' },
	{ text: 'He\u2019s also a terrific collaborator. Low ego, high output, and completely dependable.', title: 'Editorial leadership, MTG Media Group' },
	{ text: 'He has been an invaluable resource in my growth as a designer and a mentor throughout my career.', title: 'Art Director, MTG Media Group' },
	{ text: 'Steve took the initiative to learn many new website design programs and built our first responsive design website when it was cutting edge technology.', title: 'Executive Vice President and Publisher, Meatingplace' },
	{ text: 'Whether it\u2019s website design, print design, or UI/UX, Steve approaches each project with a careful eye for detail and a deep understanding of user experience.', title: 'Marketing and Creative Leader, collaborator' },
	{ text: 'He also was in charge of the Plate website and newsletter designs, and was always thinking of ways to improve and update both platforms, making our digital products as beautiful as the print ones.', title: 'Editorial lead, Plate' },
	{ text: 'His forward-looking vision and ability to put into action new technology and innovations allowed our teams the ability to thrive in their positions whether sales or editorial and he provided our readers/users cutting edge resources.', title: 'Marketing Strategist and Project Manager, MTG Media Group' },
	{ text: 'Steve has an uncanny ability to translate complex ideas into compelling visual stories.', title: 'VP Creative and Operations, former manager' },
	{ text: 'He recognized and responded to the need to grow the company\u2019s web designs and all that it encompassed.', title: 'Creative Director, Marketing and Technology Group, 1998 to 2015' },
].map((q) => ({ ...q, href: RECS_URL }));

---

<Site
	title="Steven Vanden Heuvel · Product Designer"
	description="I make products feel considered, and I build the systems that keep them that way, usually before anyone asks. Product design, design systems, and design tooling. Formerly PayPal checkout."
>
	<section class="hero">
		<div class="hero__inner">
			<p class="hero__name display" data-reveal="words">Steven Vanden Heuvel</p>
			<h1 class="hero__claim display" data-reveal="words">I make products feel considered, and I build the systems that keep them that way, usually before anyone asks.</h1>
			<p class="hero__proof" data-reveal="words">Responsive web in B2B publishing before it was standard. Atomic design before it had a name. Now agentic tooling, on PayPal checkout.</p>
			<p class="hero__valid" data-reveal="block">Four Jesse H. Neal Awards, one for Best Website.</p>
			<div class="hero__cta" data-reveal="block">
				<a class="btn btn--primary" href="#work">View work</a>
				<a class="btn" href="/resume">Resume</a>
			</div>
		</div>
		<a class="hero__cue" href="#work" aria-label="Scroll to selected work" data-reveal="block"><span class="hero__cue-line"></span></a>
	</section>

	<section id="work" class="deck deck--work" data-mode="flip" aria-labelledby="work-title" style={`--n: ${cases.length}`}>
		<div class="deck__track">
			{cases.map((c, i) => c.anchor && <span class="deck__anchor" id={c.anchor} style={`--j: ${i}`} aria-hidden="true"></span>)}
			<div class="deck__stage">
				<h2 id="work-title" class="work__lede display">Case studies</h2>
				<ol class="deck__cards">
					{cases.map((c) => (
						<li class="deck__card">
							<a class="card" href={c.href} data-case aria-label={`${c.head} Read the case study.`}>
								<div class={`card__art card__art--${c.art}`}>
									{c.image && <img src={c.image} alt="" loading="lazy" />}
									{!c.image && c.art === 'plugin' && <PluginPipeline />}
									{!c.image && c.art === 'checkout' && <OneClickCheckout />}
									{!c.image && c.art === 'journey' && <JourneyMap />}
								</div>
								<div class="card__body">
									<h3 class="card__head">{c.head}</h3>
									<p class="card__text">{c.text}</p>
									<dl class="card__meta">
										<div><dt>Product</dt><dd>{c.product}</dd></div>
										<div><dt>Objective</dt><dd>{c.objective}</dd></div>
									</dl>
									<span class="card__cta">Read case study <span class="arrow">→</span></span>
								</div>
							</a>
						</li>
					))}
				</ol>
			</div>
		</div>
		<div class="deck__after">
			<a class="deck__more" href="/work">All work, including Alt-Meat, Project Blackbird, and the labs <span class="arrow">→</span></a>
		</div>
	</section>

	<section id="recommendations" class="deck deck--recs" data-mode="fan" data-per="0.42" aria-labelledby="rec-title" style={`--n: ${quotes.length}; --per: 0.42`}>
		<div class="deck__track">
			<div class="deck__stage recs__stage">
				<h2 id="rec-title" class="recs__lede display">On the record.</h2>
				<ol class="recs__fan">
					{quotes.map((q) => (
						<li class="recs__card">
							<figure class="quote">
								<svg class="quote__mark" viewBox="0 0 37 32" aria-hidden="true"><path d="M16.5 16H8.5c0 4.4 3.6 8 8 8v8C7.7 32 .5 24.8.5 16V0h16v16Zm20 0h-8c0 4.4 3.6 8 8 8v8c-8.8 0-16-7.2-16-16V0h16v16Z" fill="currentColor"/></svg>
								<blockquote class="quote__text"><p>{q.text}</p></blockquote>
								<figcaption class="quote__title">{q.title}</figcaption>
							</figure>
						</li>
					))}
				</ol>
			</div>
		</div>
	</section>

	<section id="how" class="section section--how">
		<div class="wrap">
			<p class="eyebrow" data-reveal="block">How I work</p>
			<h2 class="how__lede display" data-reveal="words">The tools got me to the real problem faster. They did not have the idea.</h2>
			<ul class="how__list">
				<li data-reveal="block">
					<h3 class="how__tool display">Figma</h3>
					<p>Where the work happens, and now something I build on top of rather than only inside. I write plugins against the plugin API and pull from the REST API.</p>
				</li>
				<li data-reveal="block">
					<h3 class="how__tool display">Claude Code and Cursor</h3>
					<p>The other half of the day. I build tooling around my own process, and read, debug, and extend front-end code so I can check how something will behave. I direct them and review what comes back.</p>
				</li>
				<li data-reveal="block">
					<h3 class="how__tool display">Storybook</h3>
					<p>Where there is a component layer worth keeping honest. Two live conversions of my Pattern Labs, and a proof of concept at PayPal that treated a product string as a token.</p>
				</li>
				<li data-reveal="block">
					<h3 class="how__tool display">Creative Cloud</h3>
					<p>Where the brand and print side of the record lives: magazine covers and features, the Alt-Meat identity, and the photography and illustration direction the systems had to hold.</p>
				</li>
			</ul>
		</div>
	</section>

	<section class="section section--awards">
		<div class="wrap">
			<p class="eyebrow" data-reveal="block">Recognition</p>
			<ul class="awards" data-reveal="block">
				<li><strong>4</strong><span>Jesse H. Neal Awards</span></li>
				<li><strong>6</strong><span>Neal Finalist Recognitions</span></li>
				<li><strong>1</strong><span>Grand Neal Finalist (top 4 nationally)</span></li>
				<li class="awards__break" aria-hidden="true"></li>
				<li><span>Folio Ozzie Honorable Mention</span></li>
				<li><span>ASBPE Awards, Putman Media</span></li>
				<li><span>Northwestern Medill Guest Speaker</span></li>
			</ul>
		</div>
	</section>

	<section id="about" class="section section--about">
		<div class="wrap about">
			<img class="about__photo" src="/images/about/headshot.jpg" alt="Steven Vanden Heuvel" width="500" height="500" loading="lazy" data-reveal="block" />
			<p class="eyebrow" data-reveal="block">About</p>
			<div class="about__copy prose" data-reveal="block">
				<p>I design product flows end to end, and I build the design systems and tools that keep the quality up after the first version ships. Most of the time nobody asked me to build them.</p>
				<p>Eighteen years as VP and Creative Director at MTG Media Group is where the product habits come from. I ran the content strategy workshop that set Plate&rsquo;s taxonomy, built the Pattern Lab one level at a time so the room approved atoms before pages, themed the Drupal site myself, tested it on UserTesting.com before launch, and directed the photography, video, and illustration the system had to hold.</p>
				<p class="about__seat">What I am looking for: a Senior or Staff Product Designer seat where one person holds the whole flow, design systems are part of the job rather than the whole job, and tooling is wanted. In house, remote or Chicago.</p>
			</div>
		</div>
	</section>

	<section id="contact" class="section section--contact">
		<div class="wrap contact">
			<h2 class="contact__title display" data-reveal="words">Let's talk.</h2>
			<ul class="contact__list" data-reveal="block">
				<li><a class="js-email" data-eml="73746576656e4073746576656e64657369676e636f2e636f6d" href="#" aria-label="Email Steven">steven [at] stevendesignco [dot] com</a></li>
				<li><a href="https://linkedin.com/in/stevendesignco" target="_blank" rel="noopener">linkedin.com/in/stevendesignco</a></li>
			</ul>
			<p class="contact__based" data-reveal="block">Aurora, IL · Chicago area · Open to remote</p>
		</div>
	</section>

	<div class="modal" id="case-modal" role="dialog" aria-modal="true" aria-label="Case study" data-lenis-prevent hidden>
		<div class="modal__body">
			<button class="modal__close" type="button" aria-label="Close case study">
				<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1 1L15 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M1 15L15 1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
			</button>
			<div class="modal__content"></div>
		</div>
	</div>
</Site>

<script>
	import Lenis from 'lenis';
	import 'lenis/dist/lenis.css';

	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	// Smooth scroll, the same library the reference site runs. Native scrolling
	// underneath, so sticky positioning and scroll events keep working.
	let lenis: Lenis | null = null;
	if (!reduce) {
		lenis = new Lenis({ autoRaf: true, anchors: true, lerp: 0.1 });
	}

	// Reveal. Text marked data-reveal="words" is split into masked words that
	// slide up with a stagger; data-reveal="block" fades and lifts as one. The hero
	// runs on load once fonts are ready; everything else runs when it scrolls in.
	document.querySelectorAll<HTMLElement>('[data-reveal="words"]').forEach((el) => {
		const words = (el.textContent || '').trim().split(/\s+/);
		el.textContent = '';
		words.forEach((w, i) => {
			const mask = document.createElement('span');
			mask.className = 'rw';
			const inner = document.createElement('span');
			inner.className = 'rw__i';
			inner.style.setProperty('--i', String(i));
			inner.textContent = w;
			mask.appendChild(inner);
			el.appendChild(mask);
			if (i < words.length - 1) el.appendChild(document.createTextNode(' '));
		});
	});
	const revealEls = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
	const heroEls = revealEls.filter((el) => el.closest('.hero'));
	const restEls = revealEls.filter((el) => !el.closest('.hero'));
	const show = (el: HTMLElement) => el.classList.add('is-in');
	if (reduce) {
		revealEls.forEach(show);
	} else {
		const start = () => heroEls.forEach((el, i) => setTimeout(() => show(el), 120 + i * 140));
		if (document.fonts && document.fonts.ready) document.fonts.ready.then(start); else start();
		const io = new IntersectionObserver((entries) => {
			entries.forEach((e) => {
				if (e.isIntersecting) { show(e.target as HTMLElement); io.unobserve(e.target); }
			});
		}, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });
		restEls.forEach((el) => io.observe(el));
	}

	// Decks. The track is (n + 1) screens tall and the stage sticks for n of them.
	// Scroll position inside the track sets a target for every card: a signed
	// offset, 0 at center, +1 waiting, -1 gone. The flip deck (work) renders that
	// target directly. The swing deck (recommendations) lets each card drift
	// toward its target and settle, so it floats in from the bottom right and
	// floats out to the top left instead of tracking the scroll one to one.
	// Reduced motion gets a plain list.
	const smooth = (x: number) => x * x * (3 - 2 * x);
	const clamp = (x: number, a: number, b: number) => Math.min(b, Math.max(a, x));
	document.querySelectorAll<HTMLElement>('.deck').forEach((deck) => {
		const track = deck.querySelector<HTMLElement>('.deck__track');
		const cards = Array.from(deck.querySelectorAll<HTMLElement>('.deck__card, .recs__card'));
		const mode = deck.dataset.mode || 'flip';
		const per = parseFloat(deck.dataset.per || '1') || 1;
		// Share of the remaining distance a card closes each frame. 1 tracks the
		// scroll exactly; smaller values make the card drift and settle.
		const ease = mode === 'swing' ? 0.065 : 1;
		const n = cards.length;
		if (!track || !n) return;
		const target = cards.map((_, j) => (j === 0 ? 0 : 1));
		const current = target.slice();
		let raf = 0;
		let inView = false;

		const measure = () => {
			const vh = window.innerHeight;
			const t = clamp(-track.getBoundingClientRect().top / (vh * per), 0, mode === 'fan' ? n - 1 : n - 0.0001);
			const i = Math.floor(t);
			const lp = t - i;
			if (mode === 'fan') {
				// Continuous fan: card j sits at slot (j - t), so the whole spread
				// slides one slot per card as the page scrolls. The centered card is
				// lifted, upright and on top; the rest lean away and sit behind it.
				const first = cards[0];
				const w = first.getBoundingClientRect().width || 440;
				const spacing = w * 0.46;
				for (let j = 0; j < n; j++) {
					const card = cards[j];
					const o = j - t;
					const a = Math.abs(o);
					if (a > 3.6) { card.style.visibility = 'hidden'; continue; }
					card.style.visibility = 'visible';
					const near = Math.min(1, a);
					const scale = 1 - 0.06 * near;
					const lift = -20 * (1 - near);
					card.style.transform =
						`translate3d(${(o * spacing).toFixed(1)}px, ${(a * 9 + lift).toFixed(1)}px, 0) ` +
						`rotateZ(${(o * 7).toFixed(2)}deg) rotateX(${(near * 7).toFixed(2)}deg) scale(${scale.toFixed(3)})`;
					card.style.zIndex = String(Math.round(100 - a * 10));
				}
				return;
			}
			let kOut = 0;
			let kIn = 0;
			if (mode === 'swing') {
				// Hold at center, leave, a beat with only the line showing, then the next arrives.
				const hold = 0.18, outEnd = 0.44, inStart = 0.6;
				kOut = i < n - 1 ? smooth(clamp((lp - hold) / (outEnd - hold), 0, 1)) : 0;
				kIn = smooth(clamp((lp - inStart) / (1 - inStart), 0, 1));
			} else {
				const hold = 0.55;
				kOut = i < n - 1 ? smooth(clamp((lp - hold) / (1 - hold), 0, 1)) : 0;
				kIn = kOut;
			}
			for (let j = 0; j < n; j++) {
				if (j < i) target[j] = -1;
				else if (j === i) target[j] = -kOut;
				else if (j === i + 1) target[j] = 1 - kIn;
				else target[j] = 1;
			}
		};

		const render = () => {
			cards.forEach((card, j) => {
				const s = current[j];
				const a = Math.abs(s);
				if (mode === 'swing') {
					const sc = 1 - 0.05 * a;
					card.style.transform = `translate3d(${(s * 58).toFixed(2)}vw, ${(s * 50).toFixed(2)}vh, 0) rotateY(${(s * 22).toFixed(2)}deg) rotateX(${(-s * 12).toFixed(2)}deg) rotateZ(${(s * 3).toFixed(2)}deg) scale(${sc.toFixed(3)})`;
					card.style.opacity = (1 - smooth(clamp((a - 0.35) / 0.65, 0, 1))).toFixed(3);
					card.style.setProperty('--dim', Math.min(1, a * 1.5).toFixed(3));
				} else {
					card.style.transform = `rotateX(${(-s * 180).toFixed(2)}deg)`;
					card.style.opacity = '';
					card.style.setProperty('--dim', '0');
				}
				card.style.visibility = a >= 0.995 ? 'hidden' : 'visible';
				card.style.zIndex = String(Math.round(100 - a * 100));
			});
		};

		const tick = () => {
			raf = 0;
			let moving = false;
			for (let j = 0; j < n; j++) {
				const d = target[j] - current[j];
				if (Math.abs(d) > 0.0008) { current[j] += d * ease; moving = true; }
				else current[j] = target[j];
			}
			render();
			if (moving && inView) raf = requestAnimationFrame(tick);
		};
		// The fan maps scroll straight to a transform in measure(), so it must not
		// run the easing loop; that loop renders flip and swing only and would
		// overwrite the fan's transforms.
		const kick = () => { if (mode === 'fan') return; if (!raf) raf = requestAnimationFrame(tick); };

		if (reduce) {
			cards.forEach((c) => { c.style.transform = ''; c.style.zIndex = ''; c.style.visibility = ''; c.style.opacity = ''; c.style.setProperty('--dim', '0'); });
			return;
		}
		const io = new IntersectionObserver(([e]) => {
			inView = e.isIntersecting;
			if (inView) { measure(); kick(); }
		});
		io.observe(track);
		window.addEventListener('scroll', () => { measure(); kick(); }, { passive: true });
		window.addEventListener('resize', () => { measure(); kick(); });
		measure();
		if (mode !== 'fan') {
			for (let j = 0; j < n; j++) current[j] = target[j];
			render();
		}
	});

	// Case study modal. A card click flips the case study in over the blurred page
	// and never leaves it. The content is the existing case study page, fetched and
	// dropped into the card, so the standalone URLs keep working for links sent by
	// email. The URL updates while it is open, so Back closes it.
	const modal = document.getElementById('case-modal') as HTMLElement | null;
	const modalContent = modal?.querySelector<HTMLElement>('.modal__content') || null;
	const modalClose = modal?.querySelector<HTMLButtonElement>('.modal__close') || null;
	const loaded = new Map<string, string>();
	let openUrl: string | null = null;
	let lastFocus: HTMLElement | null = null;
	let hideTimer = 0;

	async function fetchCase(path: string): Promise<string> {
		const cached = loaded.get(path);
		if (cached) return cached;
		const res = await fetch(path, { headers: { Accept: 'text/html' } });
		if (!res.ok) throw new Error(String(res.status));
		const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
		// Bring the page's own styles along. Production inlines them as <style>;
		// the dev server serves them as style modules.
		doc.querySelectorAll<HTMLStyleElement>('head style').forEach((st, idx) => {
			const key = `${path}#${idx}`;
			if (document.head.querySelector(`style[data-case-style="${CSS.escape(key)}"]`)) return;
			const c = st.cloneNode(true) as HTMLStyleElement;
			c.setAttribute('data-case-style', key);
			document.head.appendChild(c);
		});
		doc.querySelectorAll<HTMLLinkElement>('head link[rel="stylesheet"]').forEach((ln) => {
			const href = ln.getAttribute('href') || '';
			if (!href || document.head.querySelector(`link[href="${CSS.escape(href)}"]`)) return;
			document.head.appendChild(ln.cloneNode(true));
		});
		doc.querySelectorAll<HTMLScriptElement>('script[type="module"][src*="type=style"]').forEach((sc) => {
			import(/* @vite-ignore */ sc.src).catch(() => {});
		});
		const main = doc.querySelector('main');
		const html = main ? main.innerHTML : '<p>Could not load this case study.</p>';
		loaded.set(path, html);
		return html;
	}

	async function showCase(url: string) {
		if (!modal || !modalContent) return;
		const u = new URL(url, location.origin);
		modalContent.innerHTML = '<p class="modal__loading">Loading</p>';
		try {
			modalContent.innerHTML = await fetchCase(u.pathname);
		} catch {
			modalContent.innerHTML = '<p class="modal__loading">Could not load this case study. <a href="' + u.pathname + '">Open it as a page.</a></p>';
		}
		modalContent.querySelectorAll('[data-animate]').forEach((el) => el.classList.add('is-visible'));
		modalContent.querySelectorAll<HTMLElement>('.cs-back-top').forEach((el) => { el.hidden = true; });
		const target = u.hash ? modalContent.querySelector<HTMLElement>(u.hash) : null;
		requestAnimationFrame(() => {
			if (target) target.scrollIntoView({ block: 'start' });
			else modal.scrollTop = 0;
		});
	}

	function openCase(url: string, trigger: HTMLElement | null, push = true) {
		if (!modal) return;
		window.clearTimeout(hideTimer);
		lastFocus = trigger;
		const wasOpen = openUrl !== null;
		openUrl = url;
		if (push) {
			if (wasOpen) history.replaceState({ case: url }, '', url);
			else history.pushState({ case: url }, '', url);
		}
		modal.hidden = false;
		document.body.classList.add('modal-open');
		lenis?.stop();
		requestAnimationFrame(() => requestAnimationFrame(() => modal.classList.add('is-open')));
		showCase(url).then(() => modalClose?.focus());
	}

	function closeCase() {
		if (!modal || openUrl === null) return;
		openUrl = null;
		modal.classList.remove('is-open');
		document.body.classList.remove('modal-open');
		lenis?.start();
		hideTimer = window.setTimeout(() => {
			modal.hidden = true;
			if (modalContent) modalContent.innerHTML = '';
		}, 1600);
		lastFocus?.focus();
	}

	if (modal) {
		document.querySelectorAll<HTMLAnchorElement>('a[data-case]').forEach((a) => {
			a.addEventListener('click', (e) => {
				if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
				e.preventDefault();
				openCase(a.getAttribute('href') || '/', a);
			});
		});
		modalClose?.addEventListener('click', () => {
			if (history.state && history.state.case) history.back();
			else closeCase();
		});
		modal.addEventListener('click', (e) => {
			if (e.target === modal) modalClose?.click();
		});
		window.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && openUrl !== null) modalClose?.click();
		});
		// Links inside a loaded case study: other case studies open in place, the
		// links back to the home page close the modal, everything else behaves.
		modalContent?.addEventListener('click', (e) => {
			const a = (e.target as HTMLElement).closest('a');
			if (!a) return;
			const href = a.getAttribute('href') || '';
			if (a.target === '_blank') return;
			if (href.startsWith('/work/') || href.startsWith('/design-systems')) {
				e.preventDefault();
				openCase(href, lastFocus);
			} else if (href.startsWith('/#') || href === '/') {
				e.preventDefault();
				modalClose?.click();
			}
		});
		window.addEventListener('popstate', () => {
			const st = history.state;
			if (st && st.case) openCase(st.case, lastFocus, false);
			else if (openUrl !== null) closeCase();
		});
	}

