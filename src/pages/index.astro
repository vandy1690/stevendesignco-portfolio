---
import Site from '../layouts/Site.astro';
import PayPalHero from '../components/animated/PayPalHero';
---

<Site
	title="Steven Vanden Heuvel · Principal Designer at PayPal"
	description="Principal Designer at PayPal. Designing checkout and payment experiences for top global merchants. Payments. Design systems. B2B product. 18 years in."
>
	<section class="hero">
		<div class="hero__copy">
			<p class="eyebrow">Principal Designer at PayPal</p>
			<h1 class="hero__title display">Steven<br class="hero__title-br" />Vanden Heuvel</h1>
			<p class="hero__sub">Principal Designer at PayPal. Designing checkout and payment experiences for top global merchants.</p>
			<p class="hero__tagline">Payments. Design systems. B2B product.</p>
			<div class="cta-row">
				<a class="btn btn--primary" href="/resume">View Resume</a>
				<a class="btn" href="#contact">Contact</a>
				<a class="btn" href="https://linkedin.com/in/stevendesignco" target="_blank" rel="noopener">LinkedIn</a>
			</div>
		</div>
		<div class="hero__art">
			<PayPalHero client:load />
		</div>
	</section>

	<section id="about" class="section">
		<div class="section__inner about">
			<p class="eyebrow">About</p>
			<div class="prose">
				<p>Currently a Principal Designer at PayPal (contract via MagnitGlobal), working on the Merchant Enablement team. Over the past six months I have shipped 20+ merchant proposal packages on weekly sprint cycles for top global brands including <strong>Home Depot, Nintendo, Target, Best Buy, TikTok Shop, Chewy, and Microsoft</strong>. The work feeds PayPal's top priority of growing TPV through greater checkout prominence.</p>
				<p>Before PayPal I spent 18 years at MTG Media Group, growing from Senior Art Director to VP and Creative Director. I led a 6 person team and built responsive web products and design systems for <strong>7 brands serving 128,000+ B2B professionals</strong>. Plate, the website I rebuilt as a responsive product, won the 2017 Jesse H. Neal Award for Best Website. Four-time Neal Award winner overall.</p>
				<p>Through Steven Design Services LLC I also take on select contract design work, focused on design systems, responsive web products, and product strategy.</p>
			</div>
		</div>
	</section>

	<section id="work" class="section section--alt">
		<div class="section__inner">
			<p class="eyebrow">Selected Work</p>
			<h2 class="section__title">Case studies</h2>
		</div>
		<div class="section__inner">
			<div class="work-grid">
				<a class="card" href="/work/paypal">
					<div class="card__media card__media--paypal">
						<img src="/images/case-studies/_logos/paypal-black.svg" alt="PayPal" />
					</div>
					<div class="card__content">
						<div class="card__role">Principal Designer · PayPal</div>
						<h3 class="card__title">Becoming the Default at Checkout</h3>
						<p class="card__body">PayPal's prominence at checkout varied by merchant. I shipped per-merchant proposals to make it consistent and grow TPV.</p>
						<span class="card__cta">Read case study <span class="arrow">→</span></span>
					</div>
				</a>
				<a class="card" href="/work/plate">
					<div class="card__media card__media--photo">
						<img src="/images/case-studies/plate/plate-hero-light.png" alt="" aria-hidden="true" loading="lazy" />
					</div>
					<div class="card__content">
						<div class="card__role">Creative Director · MTG Media Group</div>
						<h3 class="card__title">Plate: Website Redesign</h3>
						<p class="card__body">Building the digital platform for chefs and foodservice professionals. Won the 2017 Jesse H. Neal Award for Best Website.</p>
						<span class="card__cta">Read case study <span class="arrow">→</span></span>
					</div>
				</a>
				<a class="card" href="/work/blackbird">
					<div class="card__media card__media--photo">
						<img src="/images/case-studies/blackbird/blackbird-hero-light.png" alt="" aria-hidden="true" loading="lazy" />
					</div>
					<div class="card__content">
						<div class="card__role">Creative Director / Design Lead · MTG Media Group</div>
						<h3 class="card__title">Project Blackbird</h3>
						<p class="card__body">An interactive oral history of the restaurant that transformed Chicago's dining. Grand Jesse H. Neal Finalist, top 4 nationally.</p>
						<span class="card__cta">Read case study <span class="arrow">→</span></span>
					</div>
				</a>
				<a class="card" href="/work/alt-meat">
					<div class="card__media card__media--photo">
						<img src="/images/case-studies/alt-meat/alt-meat-hero-light.png" alt="" aria-hidden="true" loading="lazy" />
					</div>
					<div class="card__content">
						<div class="card__role">Creative Director · MTG Media Group</div>
						<h3 class="card__title">Alt-Meat</h3>
						<p class="card__body">Brand identity, magazine, and responsive news site for MTG's alternative protein property. Designed in under 90 days.</p>
						<span class="card__cta">Read case study <span class="arrow">→</span></span>
					</div>
				</a>
				<a class="card" href="/work/meatingplace">
					<div class="card__media card__media--photo">
						<img src="/images/case-studies/meatingplace/meatingplace-hero-light.png" alt="" aria-hidden="true" loading="lazy" />
					</div>
					<div class="card__content">
						<div class="card__role">Creative Director · MTG Media Group</div>
						<h3 class="card__title">Meatingplace</h3>
						<p class="card__body">Responsive rebuild of MTG's flagship daily news site for U.S. meat and poultry professionals. Served the largest audience across MTG's 7-brand portfolio.</p>
						<span class="card__cta">Read case study <span class="arrow">→</span></span>
					</div>
				</a>
				<div class="card card--info">
					<div class="card__media card__media--stat">
						<span class="card__stat">&lt; 60s</span>
						<span class="card__stat-label">build time</span>
					</div>
					<div class="card__content">
						<div class="card__role">Principal Designer · PayPal</div>
						<h3 class="card__title">Merchant Flow Builder</h3>
						<p class="card__body">Browser brief form and Figma plugin. Per-merchant checkout flow assembly: 30 to 60 minutes to under 60 seconds.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="section__inner">
			<p class="eyebrow">Recognition</p>
			<h2 class="section__title">Awarded work, on record.</h2>
			<ul class="awards">
				<li><strong>4</strong><span>Jesse H. Neal Awards</span></li>
				<li><strong>6</strong><span>Neal Finalist Recognitions</span></li>
				<li><strong>1</strong><span>Grand Neal Finalist (top 4 nationally)</span></li>
				<li><span class="awards__dot" aria-hidden="true">●</span><span>Folio Ozzie Honoree</span></li>
				<li><span class="awards__dot" aria-hidden="true">●</span><span>Multiple ASBPE Awards</span></li>
				<li><span class="awards__dot" aria-hidden="true">●</span><span>Northwestern Medill Guest Speaker</span></li>
			</ul>
		</div>
	</section>

	<section class="section section--alt">
		<div class="section__inner">
			<p class="eyebrow">What I Do</p>
			<h2 class="section__title">Design Systems · Responsive Web Products · Product Strategy.</h2>
			<ul class="services">
				<li>Design Systems</li>
				<li>Service Blueprints</li>
				<li>UX and UI Design</li>
				<li>Prototyping</li>
				<li>Wireframing</li>
				<li>Accessibility</li>
				<li>AI Assisted Workflows (Claude Code, Cursor)</li>
				<li>Figma</li>
			</ul>
		</div>
	</section>

	<section id="contact" class="section section--contact">
		<div class="section__inner contact">
			<h2 class="contact__title display">Let's talk.</h2>
			<ul class="contact__list">
				<li><a class="js-email" data-eml="73746576656e4073746576656e64657369676e636f2e636f6d" href="#" aria-label="Email Steven">steven [at] stevendesignco [dot] com</a></li>
				<li><a href="https://www.stevendesignco.com">stevendesignco.com</a></li>
				<li><a href="https://linkedin.com/in/stevendesignco" target="_blank" rel="noopener">linkedin.com/in/stevendesignco</a></li>
			</ul>
			<p class="contact__based">Aurora, IL · Chicago area · Open to remote</p>
		</div>
	</section>
</Site>

<style>
	.hero {
		max-width: var(--max);
		margin: 0 auto;
		padding: 96px var(--gutter) 64px;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 64px;
		align-items: center;
		min-height: calc(100vh - 80px);
		overflow: visible;
	}
	/* min-width:0 lets the copy column shrink so its text wraps instead of
	   overflowing the viewport on small screens. */
	.hero__copy { min-width: 0; }
	/* Two-line stack everywhere: "Steven" / "Vanden Heuvel". This display face is
	   wide, so the size is capped so "Vanden Heuvel" stays on one line in the hero
	   copy column and never breaks to a third line. The phone size is in the 880 block. */
	.hero__title {
		font-size: clamp(32px, 4vw, 52px);
		margin-bottom: 28px;
		letter-spacing: -0.03em;
	}
	.hero__sub {
		font-size: clamp(20px, 1.8vw, 26px);
		color: var(--text);
		max-width: 32ch;
		margin-bottom: 16px;
		line-height: 1.35;
		font-weight: 500;
	}
	.hero__tagline {
		font-size: 16px;
		color: var(--text-mute);
		margin-bottom: 36px;
		letter-spacing: -0.005em;
	}
	.hero__tagline-mark { color: var(--lime); font-weight: 600; }
	.cta-row { display: flex; flex-wrap: nowrap; gap: 12px; }
	.cta-row .btn { white-space: nowrap; flex: 0 1 auto; min-width: 0; }

	/* Full-bleed orbit. The stage is scaled up and pushed right so the outer
	   ring is cut by the right viewport edge (body has overflow-x: clip).
	   Tune these two values to taste, then they cascade to the stage transform. */
	.hero__art {
		min-width: 0;
		position: relative;
		--orbit-scale: 1.18;
		--orbit-shift: 9vw;
	}
	.hero__art :global(.pp-stage) {
		transform: translateX(var(--orbit-shift)) scale(var(--orbit-scale));
		transform-origin: center center;
	}

	.section__title {
		max-width: 22ch;
		margin: 0 0 56px;
		letter-spacing: -0.025em;
	}

	.about { display: grid; gap: 8px; }

	.work-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}
	@media (max-width: 1024px) {
		.work-grid { grid-template-columns: repeat(2, 1fr); }
	}
	@media (max-width: 720px) {
		.work-grid { grid-template-columns: 1fr; gap: 20px; }
	}
	.card {
		background: var(--surface);
		border: 1px solid var(--rule);
		border-radius: var(--radius);
		color: var(--text);
		display: flex;
		flex-direction: column;
		overflow: hidden;
		transition: transform 0.22s ease, border-color 0.22s ease, background 0.22s ease;
	}
	.card:hover {
		transform: translateY(-4px);
		border-color: var(--lime);
		background: var(--surface-2);
		color: var(--text);
	}
	.card:hover .arrow { transform: translateX(6px); color: var(--lime); }
	.card__media {
		position: relative;
		aspect-ratio: 16 / 9;
		background-color: var(--surface);
		background-size: cover;
		background-position: center;
		display: flex;
		align-items: center;
		justify-content: center;
		border-bottom: 1px solid var(--rule);
	}
	.card__media--paypal { background-color: #60cdff; }
	.card__media--paypal img { width: 56%; max-width: 200px; }
	@media (prefers-color-scheme: light) {
		:root:not([data-theme="dark"]) .card__media--paypal { background-color: #ffffff; }
	}
	:root[data-theme="light"] .card__media--paypal { background-color: #ffffff; }
	.card__media--stat {
		background-color: var(--bg);
		flex-direction: column;
		gap: 8px;
		color: var(--lime);
	}
	.card__stat {
		font-family: var(--font-display);
		font-weight: 400;
		font-style: normal;
		font-variation-settings: "wght" 400, "slnt" 0, "ital" 0;
		font-synthesis: none;
		font-size: clamp(56px, 8vw, 88px);
		line-height: 1;
		letter-spacing: normal;
		color: #000000;
	}
	.card__stat-label {
		font-family: var(--font-body);
		font-size: 11px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--text-mute);
		font-weight: 600;
	}
	.card--info { cursor: default; }
	.card--info:hover {
		transform: none;
		border-color: var(--rule);
		background: var(--surface);
	}
	/* Photo cards use the light hero mockups, now background-removed and
	   pre-framed to 16:9 so every window matches. Transparent field blends
	   into the paper; the device screens keep their own white.
	   Light-only for now; when dark mode returns, add the .jpg variants back. */
	.card__media--photo { background: var(--bg); }
	.card__media--photo img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}
	.card__content { padding: 24px 24px 26px; display: flex; flex-direction: column; gap: 12px; flex: 1; }
	.card__role { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-mute); font-weight: 600; }
	.card__title { line-height: 1.1; }
	.card__body { color: var(--text); margin: 0; font-size: 15px; line-height: 1.5; flex: 1; }
	.card__cta {
		margin-top: 8px;
		color: var(--text);
		font-weight: 600;
		font-size: 14px;
		letter-spacing: 0.01em;
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}
	.arrow { display: inline-block; transition: transform 0.22s ease, color 0.22s ease; }

	.awards {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0 32px;
	}
	.awards li {
		display: flex;
		align-items: baseline;
		gap: 18px;
		padding: 22px 0;
		border-top: 1px solid var(--rule);
		color: var(--text);
		font-size: 16px;
	}
	.awards li:last-child:nth-child(3n) { border-bottom: none; }
	.awards strong {
		font-size: 36px;
		font-weight: 700;
		color: var(--lime);
		min-width: 44px;
		font-variant-numeric: tabular-nums;
		line-height: 1;
		letter-spacing: -0.02em;
	}
	.awards__dot { color: var(--lime); font-size: 22px; min-width: 44px; }

	.services {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}
	.services li {
		padding: 12px 18px;
		background: transparent;
		border: 1px solid var(--rule);
		border-radius: 999px;
		font-size: 15px;
		color: var(--text);
		font-weight: 500;
		transition: border-color 0.14s ease, color 0.14s ease;
	}
	.services li:hover { border-color: var(--lime); color: var(--lime); }

	.section--contact { padding: 160px var(--gutter); text-align: center; }
	.contact { display: flex; flex-direction: column; align-items: center; gap: 48px; }
	.contact__title {
		color: var(--text);
		font-size: clamp(56px, 8vw, 128px);
		margin: 0;
	}
	.contact__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; font-size: clamp(18px, 1.6vw, 24px); font-weight: 600; }
	.contact__list a {
		color: var(--text);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 4px;
		transition: color 0.14s ease;
	}
	.contact__list a:hover { color: var(--lime); }
	.contact__based { color: var(--text-mute); font-size: 14px; margin: 0; letter-spacing: 0.04em; }

	@media (max-width: 880px) {
		.hero { grid-template-columns: 1fr; padding-top: 48px; gap: 32px; min-height: 0; }
		/* Phones and tablets: same two-line stack, but the copy spans the full
		   width, so the cap keeps "Vanden Heuvel" on one line down to 360px. */
		.hero__title { font-size: clamp(24px, 7.5vw, 56px); }
		.hero__art {
			order: -1;
			width: 100%;
			aspect-ratio: 1 / 1;
			overflow: visible;
			--orbit-shift: 0vw;
		}
		.hero__art :global(.pp-stage) { transform: scale(0.5); }
		.cta-row { gap: 8px; }
		.cta-row .btn { padding: 11px 14px; font-size: 13px; }
		.awards { grid-template-columns: 1fr; }
		.contact__list li { grid-template-columns: 1fr; gap: 6px; padding: 18px 0; font-size: 17px; }
	}
</style>
