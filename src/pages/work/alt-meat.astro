---
import Site from '../../layouts/Site.astro';
import CaseHero from '../../components/ui/CaseHero.astro';
import CaseFigure from '../../components/ui/CaseFigure.astro';
import CaseSection from '../../components/ui/CaseSection.astro';
import CaseBlock from '../../components/ui/CaseBlock.astro';
import AwardList from '../../components/ui/AwardList.astro';
import ButtonGroup from '../../components/ui/ButtonGroup.astro';
import Button from '../../components/ui/Button.astro';
import PagerPair from '../../components/ui/PagerPair.astro';
---

<Site
	title="Alt-Meat: Launching a Brand and Platform in Under 8 Weeks · Steven Vanden Heuvel"
	description="As Creative Director at MTG, I built the brand, magazine, enewsletters, and responsive news site for Alt-Meat as one system, in under 8 weeks, aimed at the growing alternative protein market."
	image="/og/alt-meat.png"
	variant="case"
>
	<CaseHero
		eyebrow="Case study"
		title="Alt-Meat: Launching a Brand and Platform in Under 8 Weeks"
		lede="MTG was entering the alternative protein market and needed a credible brand and publication before the moment passed."
		meta={[
			{ term: 'Role', value: 'Creative Director' },
			{ term: 'Org', value: 'MTG Media Group' },
			{ term: 'Recognition', value: 'Launched in under 8 weeks' },
		]}
	>
		<CaseFigure
			slot="figure"
			src="/images/case-studies/alt-meat/alt-meat-hero.jpg"
			light="/images/case-studies/alt-meat/alt-meat-hero-light.png"
			alt="Alt-Meat site and editorial across devices"
		/>
	</CaseHero>

	<CaseSection>
		<CaseBlock eyebrow="What was unclear" lede="A new market, and a short window to be credible in it.">
			<p>MTG was entering the alternative protein market, the growing non-animal protein space, and needed a credible brand and publication before the moment passed.</p>
		</CaseBlock>
	</CaseSection>

	<CaseSection alt>
		<CaseBlock eyebrow="What I led" lede="Brand, magazine, enewsletters, and site as one system, in under 8 weeks.">
			<p>I built the brand identity, the magazine, the enewsletters, and a responsive news site as one system, in under 8 weeks. The visual language tied them together so the new title read as a peer to MTG's other properties.</p>
		</CaseBlock>
	</CaseSection>

	<CaseSection>
		<CaseBlock eyebrow="Who I influenced" lede="Brand and product design, across the business.">
			<p>I led brand and product design, working with the owner and president, the Publisher, the editor, and the developers.</p>
		</CaseBlock>
	</CaseSection>

	<CaseSection alt>
		<CaseBlock eyebrow="What changed" lede="MTG launched a new property on a tight timeline, aimed at a growing audience." />
		<AwardList
			items={[
				'Brand, magazine, enewsletters, and responsive site shipped together',
				'Built in under 8 weeks, from a standing start',
			]}
		/>
	</CaseSection>

	<CaseSection>
		<CaseBlock eyebrow="Design system" lede="The component library behind this build is still browsable.">
			<p>The original Pattern Lab from the project, and the same patterns rebuilt recently in Storybook with interactive controls on the core atoms.</p>
		</CaseBlock>
		<ButtonGroup>
			<Button href="/labs/altmeat/" external>Open the Pattern Lab</Button>
			<Button href="/labs/altmeat-storybook/" external>Open the Storybook</Button>
			<Button href="/design-systems">The full practice →</Button>
		</ButtonGroup>
	</CaseSection>

	<PagerPair
		prev={{ href: '/work/blackbird', label: 'Project Blackbird', hidden: 'Previous case study: ' }}
		next={{ href: '/work/meatingplace', label: 'Meatingplace', hidden: 'Next case study: ' }}
	/>
</Site>
