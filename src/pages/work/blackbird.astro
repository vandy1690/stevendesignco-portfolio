---
import Site from '../../layouts/Site.astro';
import CaseHero from '../../components/ui/CaseHero.astro';
import CaseFigure from '../../components/ui/CaseFigure.astro';
import CaseSection from '../../components/ui/CaseSection.astro';
import CaseBlock from '../../components/ui/CaseBlock.astro';
import PagerPair from '../../components/ui/PagerPair.astro';
---

<Site
	title="Project Blackbird · Steven Vanden Heuvel"
	description="A responsive longform site telling the oral history of the Chicago restaurant that changed the city's dining. Grand Jesse H. Neal Finalist, top 4 nationally."
	image="/og/blackbird.png"
	variant="case"
>
	<CaseHero
		eyebrow="Case study"
		heading="Project Blackbird"
		lede="An oral history of the Chicago restaurant that changed the city's dining, built as a responsive longform site that did the story justice."
		meta={[
			{ term: 'Role', value: 'Creative Director / Design Lead' },
			{ term: 'Org', value: 'MTG Media Group' },
			{ term: 'Recognition', value: 'Grand Neal Finalist, top 4 nationally' },
		]}
	>
		<CaseFigure
			slot="figure"
			src="/images/case-studies/blackbird/blackbird-hero.jpg"
			light="/images/case-studies/blackbird/blackbird-hero-light.png"
			alt="Project Blackbird longform feature"
		/>
	</CaseHero>

	<CaseSection>
		<CaseBlock eyebrow="What was unclear" lede="A long story with no online form that did it justice.">
			<p>Blackbird, the Chicago restaurant that changed the city's dining, had a story worth telling at length. There was no online form that did it justice.</p>
		</CaseBlock>
	</CaseSection>

	<CaseSection tone="alt">
		<CaseBlock eyebrow="What I led" lede="A responsive longform site, told as an oral history.">
			<p>I designed and built a dynamically responsive site for longform content, told as an oral history. The layout carries the voices and the timeline across screen sizes.</p>
		</CaseBlock>
	</CaseSection>

	<CaseSection>
		<CaseBlock eyebrow="Who I directed" lede="A small team, around a site I built myself.">
			<p>I built the entire site myself. My editor supplied the content. I hired and directed an illustrator, a photographer, and a videographer, and directed the video editor.</p>
		</CaseBlock>
	</CaseSection>

	<CaseSection tone="alt">
		<CaseBlock eyebrow="What changed" lede="It put a B2B trade title on the national stage.">
			<p>🏆 Project Blackbird was named a Grand Jesse H. Neal Finalist, top 4 nationally.</p>
		</CaseBlock>
	</CaseSection>

	<PagerPair
		prev={{ href: '/work/plate', label: 'Plate', prefix: 'Previous case study: ' }}
		next={{ href: '/work/alt-meat', label: 'Alt-Meat', prefix: 'Next case study: ' }}
	/>
</Site>
