---
import Site from '../../layouts/Site.astro';
---

<Site
	title="Project Blackbird · Steven Vanden Heuvel"
	description="A responsive longform site telling the oral history of the Chicago restaurant that changed the city's dining. Grand Jesse H. Neal Finalist, top 4 nationally."
	image="/og/blackbird.png"
>
	<section class="cs-hero">
		<div class="cs-hero__inner">
			<a class="cs-back-top" href="/#work">← Case studies</a>
			<p class="eyebrow">Case study</p>
			<h1 class="cs-hero__title display">Project Blackbird</h1>
			<p class="cs-hero__lede">An oral history of the Chicago restaurant that changed the city's dining, built as a responsive longform site that did the story justice.</p>
			<div class="cs-figure" data-animate="fade">
				<img class="theme-img theme-img--dark" src="/images/case-studies/blackbird/blackbird-hero.jpg" alt="Project Blackbird longform feature" />
				<img class="theme-img theme-img--light" src="/images/case-studies/blackbird/blackbird-hero-light.png" alt="" aria-hidden="true" />
			</div>
			<dl class="cs-meta">
				<div><dt>Role</dt><dd>Creative Director / Design Lead</dd></div>
				<div><dt>Org</dt><dd>MTG Media Group</dd></div>
				<div><dt>Recognition</dt><dd>Grand Neal Finalist, top 4 nationally</dd></div>
			</dl>
		</div>
	</section>


	<section class="section">
		<div class="section__inner cs-body" data-animate="fade">
			<div class="cs-block">
				<p class="eyebrow">What was unclear</p>
				<h2 class="cs-block__lede">A long story with no online form that did it justice.</h2>
				<p>Blackbird, the Chicago restaurant that changed the city's dining, had a story worth telling at length. There was no online form that did it justice.</p>
			</div>
		</div>
	</section>

	<section class="section section--alt">
		<div class="section__inner cs-body" data-animate="fade">
			<div class="cs-block">
				<p class="eyebrow">What I led</p>
				<h2 class="cs-block__lede">A responsive longform site, told as an oral history.</h2>
				<p>I designed and built a dynamically responsive site for longform content, told as an oral history. The layout carries the voices and the timeline across screen sizes.</p>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="section__inner cs-body" data-animate="fade">
			<div class="cs-block">
				<p class="eyebrow">Who I directed</p>
				<h2 class="cs-block__lede">A small team, around a site I built myself.</h2>
				<p>I built the entire site myself. My editor supplied the content. I hired and directed an illustrator, a photographer, and a videographer, and directed the video editor.</p>
			</div>
		</div>
	</section>

	<section class="section section--alt">
		<div class="section__inner cs-body" data-animate="fade">
			<div class="cs-block">
				<p class="eyebrow">What changed</p>
				<h2 class="cs-block__lede">It put a B2B trade title on the national stage.</h2>
				<p>🏆 Project Blackbird was named a Grand Jesse H. Neal Finalist, top 4 nationally.</p>
			</div>
		</div>
	</section>

	<section class="section section--alt">
		<div class="section__inner cs-back">
			<a class="pager pager--prev" href="/work/plate"><span class="pager__cap" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3.5 5.5 8l4.5 4.5"/></svg></span><span class="sr-only">Previous case study: </span>Plate</a>
			<a class="pager" href="/work/alt-meat"><span class="sr-only">Next case study: </span>Alt-Meat<span class="pager__cap" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 3.5 4.5 4.5L6 12.5"/></svg></span></a>
		</div>
	</section>
</Site>

<style>
	.cs-hero { max-width: var(--max); margin: 0 auto; padding: var(--space-2xl) var(--gutter); }
	.cs-back-top { display: inline-flex; align-items: center; min-height: 24px; margin-bottom: var(--space-lg); color: var(--text-mute); font-size: var(--text-body-sm); }
	.cs-back-top:hover { color: var(--accent); }
	.cs-hero__title { margin: var(--space-xs) 0 var(--space-lg); max-width: 20ch; }
	.cs-hero__lede { font-size: var(--text-deck); color: var(--text); line-height: 1.5; max-width: 56ch; margin-bottom: var(--space-2xl); font-weight: 500; }
	.cs-meta { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-md); margin: 0; padding: var(--space-lg) 0 0; border-top: 1px solid var(--rule); }
	.cs-meta div { margin: 0; }
	.cs-meta dt { font-size: var(--text-label); letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-mute); font-weight: 800; margin-bottom: var(--space-xs); }
	.cs-meta dd { margin: 0; color: var(--text); font-size: var(--text-body); font-weight: 500; }

	.cs-figure { max-width: 100%; margin: var(--space-lg) 0 var(--space-xl); }
	.cs-figure img { width: 100%; height: auto; display: block; }

	/* One organism grouping: label, subhead and body sit tight together, and the
	   space between groupings is 25 percent narrower than it was. */
	.section { padding-top: var(--space-xl); padding-bottom: var(--space-xl); }

	.cs-body { display: grid; gap: var(--space-xl); max-width: var(--max-narrow); }
	/* Hierarchy: eyebrow + subhead group as the headline, body is support. */
	.cs-block .eyebrow { margin-bottom: 0; }
	/* case-study eyebrows: nickel, normal weight, .03em, black */
	.eyebrow { font-family: var(--font-display); font-weight: 400; font-variation-settings: "wght" 400, "slnt" 0, "ital" 0; font-synthesis: none; letter-spacing: 0.03em; }
	.cs-block__lede { color: var(--text); font-size: clamp(24px, 2.5vw, 32px); font-weight: 600; margin: 0; letter-spacing: -0.015em; line-height: 1.25; }
	.cs-block p { color: var(--text-mute); margin: 0; font-size: 16px; line-height: 1.65; }
	.cs-block p + p { margin-top: 0; }
	.cs-block p:not(.eyebrow):not(.cs-block__lede) + p:not(.eyebrow):not(.cs-block__lede) { margin-top: var(--space-sm); }

	.cs-awards { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
	.cs-awards li { display: flex; gap: var(--space-md); align-items: center; padding: var(--space-md) 0; border-top: 1px solid var(--rule); font-size: 18px; }
	.cs-awards li:last-child { border-bottom: 1px solid var(--rule); }
	.cs-awards__mark { display: none; }

	.cs-back { display: flex; gap: var(--space-sm); flex-wrap: wrap; justify-content: space-between; align-items: center; }
	.cs-back .btn--primary { background: var(--text); color: var(--bg); border-color: var(--text); }
	.cs-back .btn--primary:hover { background: var(--text); border-color: var(--text); color: var(--bg); box-shadow: none; }

	@media (max-width: 880px) {
		.section--figure { padding: 0 24px; }
		.cs-figure { max-width: 100%; }
		.cs-hero__title { font-size: clamp(32px, 9vw, 56px); }
	}
	@media (max-width: 700px) {
		/* Pagers stay side by side on phones: they share the row and wrap their
		   own label rather than dropping to two stacked buttons. */
		.cs-back { flex-wrap: nowrap; gap: 10px; align-items: stretch; }
		.cs-back .pager { flex: 1 1 0; min-width: 0; height: auto; min-height: 44px; padding: 9px 40px 9px 12px; font-size: 13px; line-height: 1.25; white-space: normal; }
		.cs-back .pager--prev { padding: 9px 12px 9px 40px; }
		.cs-back .pager__cap { width: 32px; }
		.cs-meta { grid-template-columns: 1fr; gap: var(--space-lg); }
		.cs-meta dt { font-size: 13px; letter-spacing: 0.1em; color: var(--text); margin-bottom: 2px; }
		.cs-meta dd { font-size: 17px; }
	}

	/* Case study links read as text, not pills: underline, accent on hover. */
	.cs-artifacts .btn, .cs-back .btn, .cs-back .btn--primary {
		padding: 0;
		border: 0;
		border-radius: 0;
		background: transparent;
		color: var(--text);
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 15px;
		letter-spacing: 0;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 5px;
		transform: none;
		box-shadow: none;
	}
	.cs-artifacts .btn:hover, .cs-back .btn:hover, .cs-back .btn--primary:hover {
		color: var(--accent);
		background: transparent;
		border: 0;
		transform: none;
		box-shadow: none;
	}
</style>
