---
import Site from '../../layouts/Site.astro';
import CaseHero from '../../components/ui/CaseHero.astro';
import CaseFigure from '../../components/ui/CaseFigure.astro';
import CaseSection from '../../components/ui/CaseSection.astro';
import CaseBlock from '../../components/ui/CaseBlock.astro';
import Quote from '../../components/ui/Quote.astro';
import ButtonGroup from '../../components/ui/ButtonGroup.astro';
import Button from '../../components/ui/Button.astro';
import PagerPair from '../../components/ui/PagerPair.astro';
---

<Site
	title="Plate: Print Brand to Digital Platform · Steven Vanden Heuvel"
	description="As Creative Director at MTG, I grew Plate from a recipe database into a full content platform for chefs and foodservice professionals. 2017 Jesse H. Neal Award for Best Website."
	image="/og/plate.png"
	variant="case"
>
	<CaseHero
		eyebrow="Case study"
		title="Plate: Repositioning a Print Brand as a Digital Platform"
		lede="Plate's website was only a recipe database. The work was to grow it into a platform that carried the whole brand."
		meta={[
			{ term: 'Role', value: 'Creative Director' },
			{ term: 'Org', value: 'MTG Media Group' },
			{ term: 'Recognition', value: '2017 Jesse H. Neal Award, Best Website' },
		]}
	>
		<CaseFigure
			slot="figure"
			src="/images/case-studies/plate/plate-scene.webp"
			alt="Plate magazine covers and a feature spread beside the responsive site on a phone"
			width={2000}
			height={960}
		/>
	</CaseHero>

	<CaseSection>
		<CaseBlock eyebrow="What was unclear" lede="A whole brand online, reduced to recipes.">
			<p>Plate's website was only a recipe database. The brand also had magazine content, daily news, and blogs, but none of it lived online in a usable structure.</p>
		</CaseBlock>
	</CaseSection>

	<CaseSection alt>
		<CaseBlock eyebrow="What I led" lede="One responsive site that carried the whole brand.">
			<p>I ported the recipe database and grew it into a full content platform, organized into Recipes, Trends, Food News, and Magazine content. One responsive site that carried the whole brand, not just recipes.</p>
		</CaseBlock>
	</CaseSection>

	<CaseSection>
		<CaseBlock eyebrow="Who I influenced" lede="The design, and the business that shipped it.">
			<p>I led the design and worked across the business to ship it: the owner and president, the finance president, the Content Director, the Publisher, the editors, and the developers.</p>
		</CaseBlock>
	</CaseSection>

	<CaseSection alt>
		<CaseBlock eyebrow="What changed" lede="The rebuilt site won the top honor in B2B publishing.">
			<p>🏆 Plate took the 2017 Jesse H. Neal Award for Best Website. The site reached 42,000 readers and 56,000 monthly pageviews, and 90 percent of subscribers said the content shaped their purchasing decisions.</p>
		</CaseBlock>
		<Quote>
			"What made it successful was not just the design. It was understanding how restaurant professionals actually worked and building something that made their jobs easier."
		</Quote>
	</CaseSection>

	<CaseSection>
		<CaseBlock eyebrow="Design system" lede="The component library behind this build is still browsable.">
			<p>The original Pattern Lab from the project, and the same patterns rebuilt recently in Storybook with interactive controls on the core atoms.</p>
		</CaseBlock>
		<ButtonGroup>
			<Button href="/labs/plate/" external>Open the Pattern Lab</Button>
			<Button href="/labs/plate-storybook/" external>Open the Storybook</Button>
			<Button href="/design-systems">The full practice →</Button>
		</ButtonGroup>
	</CaseSection>

	<PagerPair
		prev={{ href: '/work/paypal', label: 'PayPal', hidden: 'Previous case study: ' }}
		next={{ href: '/work/blackbird', label: 'Project Blackbird', hidden: 'Next case study: ' }}
	/>
</Site>
